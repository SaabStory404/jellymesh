<Project Sdk="Microsoft.NET.Sdk">

  <!-- JellyMesh Leader: one of several Jellyfin replicas (one shared database) runs the scheduled
       tasks and the library watcher, elected with a Kubernetes Lease. No second data store. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <RootNamespace>JellyMesh.Leader</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- Provided by the server at runtime; not copied into the plugin folder. -->
    <PackageReference Include="Jellyfin.Controller" Version="12.1.0" ExcludeAssets="runtime" />
    <PackageReference Include="Jellyfin.Model" Version="12.1.0" ExcludeAssets="runtime" />
  </ItemGroup>

</Project>
