<Project Sdk="Microsoft.NET.Sdk">

  <!-- Unit tests for the Galera provider. Build/test per project in Release (the Debug analyzer
       set does not match): dotnet test -c Release galera/Jellyfin.Database.Providers.Galera.Tests -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5" />
    <!-- The provider excludes these at runtime (the Jellyfin host supplies them); the test host
         has to load them itself to load the provider type. Versions match the provider. -->
    <PackageReference Include="Jellyfin.Database.Implementations" Version="12.1.0" />
    <PackageReference Include="Jellyfin.Common" Version="12.1.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.11" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Jellyfin.Database.Providers.Galera/Jellyfin.Database.Providers.Galera.csproj" />
  </ItemGroup>

</Project>
