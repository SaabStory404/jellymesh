diff --git a/src/EFCore.MySql/Query/ExpressionVisitors/Internal/MySqlTypeMappingPostprocessor.cs b/src/EFCore.MySql/Query/ExpressionVisitors/Internal/MySqlTypeMappingPostprocessor.cs
