<Project Sdk="Microsoft.NET.Sdk">

  <!-- Two-way database migration for Jellyfin: SQLite <-> Galera (MySQL/PXC), through Jellyfin's
       own EF model and both providers, so every type conversion is the providers' own. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>jellyfin-dbmigrate</AssemblyName>
    <!-- Directory holding Jellyfin.Database.Providers.Sqlite.dll from the Jellyfin 12.1 image
         (not published on NuGet): podman cp <container>:/usr/lib/jellyfin/bin/Jellyfin.Database.Providers.Sqlite.dll -->
    <JellyfinBin Condition="'$(JellyfinBin)' == ''">$(HOME)/.cache/jellymesh-vendor</JellyfinBin>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Jellyfin.Database.Implementations" Version="12.1.0" />
    <PackageReference Include="Jellyfin.Common" Version="12.1.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.11" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.11" />
    <!-- Pomelo + MySqlConnector come in through the Galera provider project. -->
    <Reference Include="Jellyfin.Database.Providers.Sqlite">
      <HintPath>$(JellyfinBin)/Jellyfin.Database.Providers.Sqlite.dll</HintPath>
    </Reference>
    <ProjectReference Include="../Jellyfin.Database.Providers.Galera/Jellyfin.Database.Providers.Galera.csproj" />
  </ItemGroup>

</Project>
