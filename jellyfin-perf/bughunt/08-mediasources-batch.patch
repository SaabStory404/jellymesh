+using System;
+using System.Collections.Generic;
+using MediaBrowser.Model.Entities;
+
+namespace MediaBrowser.Controller.Library
+{
+    /// <summary>
+    /// A page-level batch of the per-version data <see cref="Entities.BaseItem.GetVersionInfo"/> would
+    /// otherwise fetch with three separate statements per version (media streams, media attachments,
+    /// whether the version has media segments). Built once for every version id on a page of items and
+    /// consulted instead of the single-item queries; a version id this batch does not cover (for example,
+    /// one skipped by a failed batch fetch) falls back to those single-item queries unchanged.
+    /// </summary>
+    /// <param name="Streams">Media streams by version item id.</param>
+    /// <param name="Attachments">Media attachments by version item id.</param>
+    /// <param name="ItemIdsWithSegments">The subset of <paramref name="QueriedItemIds"/> that have at least one media segment.</param>
+    /// <param name="QueriedItemIds">
+    /// The version item ids this batch was built for. A miss in <see cref="Streams"/> or
+    /// <see cref="Attachments"/> for an id in this set means "queried, no rows" and must not fall back to a
+    /// single-item query; an id absent from this set was never queried and must fall back.
+    /// </param>
+    public sealed record MediaSourcePrefetch(
