diff --git a/tests/Jellyfin.Server.Implementations.Tests/Dto/DtoServiceMediaSourceBatchTests.cs b/tests/Jellyfin.Server.Implementations.Tests/Dto/DtoServiceMediaSourceBatchTests.cs
