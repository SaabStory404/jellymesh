+        /// <summary>
+        /// Batch-fetches media streams, media attachments and has-segments flags for every Video/Audio
+        /// item on the page, once, instead of the three single-item queries GetVersionInfo would
+        /// otherwise issue per item's version (600 statements for a 200-item grid). Only Video and Audio
+        /// are included: they are the only IHasMediaSources implementers whose sources route through
+        /// GetVersionInfo, so this is a page-level batch of exactly the ids that method would otherwise
+        /// query one at a time. A version id outside this batch -- an alternate version, which this page
+        /// batch does not enumerate, or one skipped because the batch fetch below failed -- falls back to
+        /// GetVersionInfo's own single-item queries unchanged.
+        /// </summary>
+        private MediaSourcePrefetch? BuildMediaSourcePrefetch(IReadOnlyList<BaseItem> items, DtoOptions options)
+        {
+            if (!options.ContainsField(ItemFields.MediaSources) && !options.ContainsField(ItemFields.MediaStreams))
+            {
+                return null;
+            }
+
+            var versionItemIds = items.Where(i => i is Video or Audio).Select(i => i.Id).ToList();
+            if (versionItemIds.Count == 0)
+            {
+                return null;
+            }
+
+            try
+            {
+                var streams = _mediaSourceManager.GetMediaStreams(versionItemIds);
+                var attachments = _mediaSourceManager.GetMediaAttachments(versionItemIds);
+                var itemIdsWithSegments = _mediaSegmentManager.HasSegments(versionItemIds);
+                return new MediaSourcePrefetch(streams, attachments, itemIdsWithSegments, versionItemIds.ToHashSet());
+            }
+            catch (Exception ex)
+            {
+                // A batch statement failing must not lose MediaSources/MediaStreams for the whole page:
+                // fall back to the single-item queries GetVersionInfo already knows how to run.
+                _logger.LogError(ex, "Batched media source prefetch failed for {Count} items, falling back to per-item queries", versionItemIds.Count);
+                return null;
+            }
+        }
