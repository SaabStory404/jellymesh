--- /dev/null
+++ b/tests/Jellyfin.Server.Implementations.Tests/Dto/DtoServiceMediaSourceBatchTests.cs
@@ -0,0 +1,365 @@
+using System;
+using System.Collections.Generic;
+using System.Data.Common;
+using System.Linq;
+using System.Text.Json;
+using Emby.Server.Implementations.Data;
+using Emby.Server.Implementations.Dto;
+using Emby.Server.Implementations.Library;
+using Jellyfin.Data.Enums;
+using Jellyfin.Database.Implementations;
+using Jellyfin.Database.Implementations.Entities;
+using Jellyfin.Database.Implementations.Enums;
+using Jellyfin.Database.Implementations.Locking;
+using Jellyfin.Database.Providers.Sqlite;
+using Jellyfin.Server.Implementations.Item;
+using Jellyfin.Server.Implementations.MediaSegments;
+using MediaBrowser.Common;
+using MediaBrowser.Common.Configuration;
+using MediaBrowser.Controller;
+using MediaBrowser.Controller.Chapters;
+using MediaBrowser.Controller.Drawing;
+using MediaBrowser.Controller.Dto;
+using MediaBrowser.Controller.Entities;
+using MediaBrowser.Controller.IO;
+using MediaBrowser.Controller.Library;
+using MediaBrowser.Controller.LiveTv;
+using MediaBrowser.Controller.MediaEncoding;
+using MediaBrowser.Controller.MediaSegments;
+using MediaBrowser.Controller.Persistence;
+using MediaBrowser.Controller.Providers;
+using MediaBrowser.Controller.Trickplay;
+using MediaBrowser.Model.Dto;
+using MediaBrowser.Model.Entities;
+using MediaBrowser.Model.Globalization;
+using MediaBrowser.Model.IO;
+using MediaBrowser.Model.Querying;
+using Microsoft.Data.Sqlite;
+using Microsoft.EntityFrameworkCore;
+using Microsoft.EntityFrameworkCore.Diagnostics;
+using Microsoft.Extensions.Logging.Abstractions;
+using Moq;
+using Xunit;
+
+namespace Jellyfin.Server.Implementations.Tests.Dto;
+
+/// <summary>
+/// Covers KNOWN ISSUE 6: a page of items with Fields=MediaSources (or MediaStreams) issued three
+/// per-version statements each (media streams, media attachments, has-segments) inside
+/// BaseItem.GetVersionInfo. DtoService.GetBaseItemDtos now batches those for the whole page; the
+/// single-item path (DtoService.GetBaseItemDto, and any version id the batch does not cover) is
+/// unchanged and is used here as the "before" baseline for both the statement count and the parity
+/// comparison.
+/// </summary>
+public sealed class DtoServiceMediaSourceBatchTests : IDisposable
+{
+    private readonly SqliteConnection _connection;
+    private readonly DbContextOptions<JellyfinDbContext> _dbOptions;
+    private readonly CommandCounter _counter;
+    private readonly DtoService _dtoService;
+    private readonly Mock<ILibraryManager> _libraryManager;
+    private readonly ILibraryManager? _previousLibraryManager;
+    private readonly IMediaSourceManager? _previousMediaSourceManager;
+    private readonly IMediaSegmentManager? _previousMediaSegmentManager;
+    private readonly IRecordingsManager? _previousRecordingsManager;
+
+    public DtoServiceMediaSourceBatchTests()
+    {
+        _counter = new CommandCounter();
+
+        _connection = new SqliteConnection("Data Source=:memory:");
+        _connection.Open();
+
+        _dbOptions = new DbContextOptionsBuilder<JellyfinDbContext>()
+            .UseSqlite(_connection)
+            .AddInterceptors(_counter)
+            .Options;
+
+        using (var context = CreateDbContext())
+        {
+            context.Database.EnsureCreated();
+        }
+
+        var dbProviderFactory = new Mock<IDbContextFactory<JellyfinDbContext>>();
+        dbProviderFactory.Setup(f => f.CreateDbContext()).Returns(CreateDbContext);
+
+        var mediaStreamRepository = new MediaStreamRepository(dbProviderFactory.Object, Mock.Of<IServerApplicationHost>(), Mock.Of<ILocalizationManager>());
+        var mediaAttachmentRepository = new MediaAttachmentRepository(dbProviderFactory.Object);
+        var mediaSegmentManager = new MediaSegmentManager(NullLogger<MediaSegmentManager>.Instance, dbProviderFactory.Object, []);
+
+        _libraryManager = new Mock<ILibraryManager>();
+
+        // Video.GetAllItemsForMediaSources() (the alternate-version enumeration BaseItem.GetMediaSources
+        // walks before GetVersionInfo) always asks for these; our items have no alternates by default.
+        // A test that needs one overrides these per-instance (Moq's most-recently-added matching setup
+        // wins), so this default only ever covers the videos that don't.
+        _libraryManager.Setup(x => x.GetLinkedAlternateVersions(It.IsAny<Video>())).Returns([]);
+        _libraryManager.Setup(x => x.GetLocalAlternateVersionIds(It.IsAny<Video>())).Returns([]);
+
+        var mediaSourceManager = new MediaSourceManager(
+            Mock.Of<IServerApplicationHost>(),
+            Mock.Of<IItemRepository>(),
+            Mock.Of<IApplicationPaths>(),
+            Mock.Of<ILocalizationManager>(),
+            Mock.Of<IUserManager>(),
+            _libraryManager.Object,
+            NullLogger<MediaSourceManager>.Instance,
+            Mock.Of<IFileSystem>(),
+            Mock.Of<IUserDataManager>(),
+            Mock.Of<IMediaEncoder>(),
+            Mock.Of<IDirectoryService>(),
+            mediaStreamRepository,
+            mediaAttachmentRepository);
+
+        var appHost = new Mock<IApplicationHost>();
+        appHost.Setup(x => x.SystemId).Returns("test-server");
+
+        // BaseItem resolves these through process-wide statics; restored in Dispose so this test
+        // class does not leak a MediaSourceManager/MediaSegmentManager bound to _connection (disposed
+        // below) to whichever test class the runner happens to run next in this process.
+        _previousLibraryManager = BaseItem.LibraryManager;
+        _previousMediaSourceManager = BaseItem.MediaSourceManager;
+        _previousMediaSegmentManager = BaseItem.MediaSegmentManager;
+        _previousRecordingsManager = Video.RecordingsManager;
+
+        BaseItem.LibraryManager = _libraryManager.Object;
+        BaseItem.MediaSourceManager = mediaSourceManager;
+        BaseItem.MediaSegmentManager = mediaSegmentManager;
+        Video.RecordingsManager = Mock.Of<IRecordingsManager>();
+
+        _dtoService = new DtoService(
+            NullLogger<DtoService>.Instance,
+            _libraryManager.Object,
+            Mock.Of<IUserDataManager>(),
+            Mock.Of<IImageProcessor>(),
+            Mock.Of<IProviderManager>(),
+            Mock.Of<IRecordingsManager>(),
+            appHost.Object,
+            mediaSourceManager,
+            new Lazy<ILiveTvManager>(() => Mock.Of<ILiveTvManager>()),
+            Mock.Of<ITrickplayManager>(),
+            Mock.Of<IChapterManager>(),
+            mediaStreamRepository,
+            mediaSegmentManager);
+    }
+
+    public void Dispose()
+    {
+        BaseItem.LibraryManager = _previousLibraryManager!;
+        BaseItem.MediaSourceManager = _previousMediaSourceManager!;
+        BaseItem.MediaSegmentManager = _previousMediaSegmentManager!;
+        Video.RecordingsManager = _previousRecordingsManager!;
+
+        _connection.Dispose();
+    }
+
+    [Theory]
+    [InlineData(10)]
+    [InlineData(50)]
+    public void GetBaseItemDtos_PageWithMediaSources_BatchesInsteadOfPerItemQueries(int itemCount)
+    {
+        var items = SeedVideos(itemCount);
+        var options = new DtoOptions(false) { EnableImages = false, EnableUserData = false, Fields = [ItemFields.MediaSources] };
+
+        // "Before": the single-item path DtoService.GetBaseItemDto (singular) still uses -- it never
+        // builds or threads a prefetch, so this is byte-for-byte the pre-fix per-item behavior.
+        _counter.Reset();
+        var before = items.Select(item => _dtoService.GetBaseItemDto(item, options)).ToList();
+        var statementsBefore = _counter.Count;
+
+        // "After": the page path, which batches the same data once for the whole page.
+        _counter.Reset();
+        var after = _dtoService.GetBaseItemDtos(items, options, skipVisibilityCheck: true);
+        var statementsAfter = _counter.Count;
+
+        // 3 statements per item before (streams, attachments, has-segments) versus 3 statements total
+        // after, regardless of page size.
+        Assert.Equal(itemCount * 3, statementsBefore);
+        Assert.Equal(3, statementsAfter);
+
+        // Parity: identical DTOs (order and content) whichever path built them.
+        Assert.Equal(items.Count, after.Count);
+        for (var i = 0; i < items.Count; i++)
+        {
+            Assert.Equal(Serialize(before[i]), Serialize(after[i]));
+        }
+    }
+
+    [Fact]
+    public void GetBaseItemDtos_MediaStreamsOnlyField_AlsoBatches()
+    {
+        // The second call site (AttachBasicFields' MediaStreams-only fallback, used when a client asks
+        // for Fields=MediaStreams without also asking for MediaSources) must consult the same batch.
+        var items = SeedVideos(4);
+        var options = new DtoOptions(false) { EnableImages = false, EnableUserData = false, Fields = [ItemFields.MediaStreams] };
+
+        _counter.Reset();
+        var before = items.Select(item => _dtoService.GetBaseItemDto(item, options)).ToList();
+        var statementsBefore = _counter.Count;
+
+        _counter.Reset();
+        var after = _dtoService.GetBaseItemDtos(items, options, skipVisibilityCheck: true);
+        var statementsAfter = _counter.Count;
+
+        Assert.Equal(items.Count * 3, statementsBefore);
+        Assert.Equal(3, statementsAfter);
+
+        for (var i = 0; i < items.Count; i++)
+        {
+            Assert.Equal(Serialize(before[i].MediaStreams), Serialize(after[i].MediaStreams));
+            Assert.NotEmpty(after[i].MediaStreams);
+        }
+    }
+
+    [Fact]
+    public void GetBaseItemDtos_ItemWithNoStreamsOrSegments_DoesNotFallBackPerItem()
+    {
+        // A batched miss (an id the page batch covers but that has no rows) must not be mistaken for
+        // "not fetched" and re-queried one at a time -- that would silently undo the fix for exactly the
+        // streamless items (extras, placeholders) a real library also has.
+        var withData = SeedVideos(1)[0];
+        var withoutData = new Video { Id = Guid.NewGuid(), Name = "No Streams" };
+        AddBaseItem(withoutData.Id, "No Streams");
+
+        var options = new DtoOptions(false) { EnableImages = false, EnableUserData = false, Fields = [ItemFields.MediaSources] };
+
+        _counter.Reset();
+        var after = _dtoService.GetBaseItemDtos([withData, withoutData], options, skipVisibilityCheck: true);
+
+        // 1 batch statement each for streams/attachments/segments, still 3 total -- not 3 + 3 for the
+        // streamless item falling back.
+        Assert.Equal(3, _counter.Count);
+        Assert.Empty(after[1].MediaSources[0].MediaStreams);
+        Assert.Empty(after[1].MediaSources[0].MediaAttachments);
+        Assert.False(after[1].MediaSources[0].HasSegments);
+    }
+
+    [Fact]
+    public void GetBaseItemDtos_AlternateVersionNotOnPage_FallsBackForThatVersionOnly()
+    {
+        // The page batch only covers the version ids actually on the page (BuildMediaSourcePrefetch
+        // batches accessibleItems, not their alternate versions). A local alternate version -- common in
+        // this library, e.g. a remux plus a smaller direct-play copy -- is a real version GetVersionInfo
+        // still has to build a MediaSourceInfo for, just not one the batch fetched: it must fall back to
+        // the single-item queries for that one version without losing the batch for the rest of the page.
+        var primary = SeedVideos(1)[0];
+        var alternate = SeedVideos(1)[0];
+        alternate.Name = "Alternate cut";
+
+        _libraryManager.Setup(x => x.GetLocalAlternateVersionIds(primary)).Returns([alternate.Id]);
+        _libraryManager.Setup(x => x.GetItemById(alternate.Id)).Returns(alternate);
+
+        var options = new DtoOptions(false) { EnableImages = false, EnableUserData = false, Fields = [ItemFields.MediaSources] };
+
+        _counter.Reset();
+        var before = _dtoService.GetBaseItemDto(primary, options);
+        var statementsBefore = _counter.Count;
+
+        _counter.Reset();
+        var after = _dtoService.GetBaseItemDtos([primary], options, skipVisibilityCheck: true)[0];
+        var statementsAfter = _counter.Count;
+
+        // Both versions' streams/attachments/segments: 3 for the primary (batched or, in the "before"
+        // case, single-item) plus 3 for the alternate, which is never on the page batch either way.
+        Assert.Equal(6, statementsBefore);
+        Assert.Equal(6, statementsAfter);
+        Assert.Equal(2, after.MediaSources.Length);
+        Assert.Equal(Serialize(before), Serialize(after));
+    }
+
+    private List<Video> SeedVideos(int count)
+    {
+        var items = new List<Video>(count);
+        for (var i = 0; i < count; i++)
+        {
+            var id = Guid.NewGuid();
+            AddBaseItem(id, "Video " + i.ToString(System.Globalization.CultureInfo.InvariantCulture));
+
+            using (var context = CreateDbContext())
+            {
+                context.MediaStreamInfos.Add(new MediaStreamInfo
+                {
+                    ItemId = id,
+                    Item = null!,
+                    StreamIndex = 0,
+                    StreamType = MediaStreamTypeEntity.Video,
+                    Codec = "h264",
+                    Width = 1920,
+                    Height = 1080
+                });
+                context.AttachmentStreamInfos.Add(new AttachmentStreamInfo
+                {
+                    ItemId = id,
+                    Item = null!,
+                    Index = 0,
+                    Codec = "attachment",
+                    Filename = "cover.jpg"
+                });
+
+                // Every other item has a media segment, to exercise both sides of HasSegments.
+                if (i % 2 == 0)
+                {
+                    context.MediaSegments.Add(new MediaSegment
+                    {
+                        ItemId = id,
+                        Type = MediaSegmentType.Intro,
+                        StartTicks = 0,
+                        EndTicks = 1000,
+                        SegmentProviderId = "test"
+                    });
+                }
+
+                context.SaveChanges();
+            }
+
+            items.Add(new Video { Id = id, Name = "Video " + i.ToString(System.Globalization.CultureInfo.InvariantCulture) });
+        }
+
+        return items;
+    }
+
+    private void AddBaseItem(Guid id, string name)
+    {
+        using var context = CreateDbContext();
+        context.BaseItems.Add(new BaseItemEntity
+        {
+            Id = id,
+            Name = name,
+            Type = new ItemTypeLookup().BaseItemKindNames[BaseItemKind.Movie]
+        });
+        context.SaveChanges();
+    }
+
+    private JellyfinDbContext CreateDbContext() => new(
+        _dbOptions,
+        NullLogger<JellyfinDbContext>.Instance,
+        new SqliteDatabaseProvider(Mock.Of<IApplicationPaths>(), NullLogger<SqliteDatabaseProvider>.Instance),
+        new NoLockBehavior(NullLogger<NoLockBehavior>.Instance));
+
+    private static string Serialize<T>(T value) => JsonSerializer.Serialize(value);
+
+    private sealed class CommandCounter : DbCommandInterceptor
+    {
+        public int Count { get; private set; }
+
+        public void Reset() => Count = 0;
+
+        public override InterceptionResult<DbDataReader> ReaderExecuting(DbCommand command, CommandEventData eventData, InterceptionResult<DbDataReader> result)
+        {
+            Count++;
+            return result;
+        }
+
+        public override InterceptionResult<int> NonQueryExecuting(DbCommand command, CommandEventData eventData, InterceptionResult<int> result)
+        {
+            Count++;
+            return result;
+        }
+
+        public override InterceptionResult<object> ScalarExecuting(DbCommand command, CommandEventData eventData, InterceptionResult<object> result)
+        {
+            Count++;
+            return result;
+        }
+    }
+}
