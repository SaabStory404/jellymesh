+    [Fact]
+    public async Task OnUserDataSaved_SendThrows_OtherUsersStillNotifiedAndProcessSurvives()
+    {
+        // The flush is an async void timer callback: an exception escaping it terminates the process.
+        // A database failover makes building the message throw; that must cost one push, not the server.
+        var failing = Guid.NewGuid();
+        var sent = 0;
+        _sessionManager.Reset();
+        _sessionManager
+            .Setup(e => e.SendMessageToUserSessions(
+                It.IsAny<System.Collections.Generic.List<Guid>>(),
+                SessionMessageType.UserDataChanged,
+                It.IsAny<Func<UserDataChangeInfo>>(),
+                It.IsAny<CancellationToken>()))
+            .Returns<System.Collections.Generic.List<Guid>, SessionMessageType, Func<UserDataChangeInfo>, CancellationToken>((ids, _, _, _) =>
+            {
+                if (ids.Contains(failing))
+                {
+                    throw new InvalidOperationException("database unavailable");
+                }
+
+                Interlocked.Increment(ref sent);
+                return Task.CompletedTask;
+            });
+
+        var notifier = CreateNotifier();
+        await notifier.StartAsync(TestContext.Current.CancellationToken);
+        RaiseUserDataSaved(failing);
+        RaiseUserDataSaved(Guid.NewGuid());
+
+        var stopwatch = Stopwatch.StartNew();
+        while (stopwatch.Elapsed < _flushTimeout && Volatile.Read(ref sent) == 0)
+        {
+            await Task.Delay(25, TestContext.Current.CancellationToken);
+        }
+
+        Assert.Equal(1, Volatile.Read(ref sent));
+
+        await notifier.StopAsync(TestContext.Current.CancellationToken);
+        notifier.Dispose();
+    }
