+        /// <summary>
+        /// Determines whether a request's reported client identifies itself as the built-in Jellyfin Web
+        /// client while reporting a version strictly older than the given server version.
+        /// </summary>
+        /// <param name="client">The <c>Client</c> value reported by the request, if any.</param>
+        /// <param name="version">The <c>Version</c> value reported by the request, if any.</param>
+        /// <param name="serverVersion">
+        /// This server's own application version (<c>IServerApplicationHost.ApplicationVersion</c>), which is the
+        /// 4-part assembly version; only the Major/Minor/Build components are meaningful for this comparison (see
+        /// <c>IServerApplicationHost.ApplicationVersionString</c>, which is that same version formatted to 3
+        /// parts) - both sides are normalized to 3 parts below so an up-to-date client is never misreported as
+        /// stale merely because it omits a Revision the server's assembly version happens to carry.
+        /// </param>
+        /// <returns><c>true</c> if this looks like a stale Jellyfin Web client; otherwise, <c>false</c>.</returns>
+        internal static bool IsStaleWebClient(string? client, string? version, Version serverVersion)
+        {
+            if (!string.Equals(client, JellyfinWebClientName, StringComparison.OrdinalIgnoreCase))
+            {
+                return false;
+            }
+
+            if (!Version.TryParse(version, out var clientVersion))
+            {
+                return false;
+            }
+
+            return NormalizeToThreePart(clientVersion) < NormalizeToThreePart(serverVersion);
+        }
+
+        /// <summary>
+        /// Reduces a <see cref="Version"/> to its Major/Minor/Build components, treating an absent (-1) Build
+        /// or Revision as 0, so a 3-part client version and a 4-part assembly version compare correctly.
+        /// </summary>
+        /// <param name="version">The version to normalize.</param>
+        /// <returns>An equivalent version with exactly 3, non-negative components.</returns>
+        private static Version NormalizeToThreePart(Version version)
+        {
+            return new Version(version.Major, version.Minor, Math.Max(version.Build, 0));
+        }
+
