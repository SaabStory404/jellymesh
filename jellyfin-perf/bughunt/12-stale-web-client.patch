@@ -0,0 +1,37 @@
+using System;
+using Jellyfin.Server.Implementations.Security;
+using Xunit;
+
+namespace Jellyfin.Server.Implementations.Tests.Security;
+
+public class AuthorizationContextTests
+{
+    // IServerApplicationHost.ApplicationVersion is the assembly version, which is always 4-part
+    // (e.g. "12.1.0.0"), not the 3-part "12.1.0" that Jellyfin Web itself reports. Modeling the
+    // fixture on the real 4-part shape is what catches a naive Version comparison treating an
+    // up-to-date 3-part client as older solely because it has no 4th (Revision) component.
+    private static readonly Version ServerVersion = new Version(12, 1, 0, 0);
+
+    [Theory]
+    [InlineData("Jellyfin Web", "12.0.0")]
+    [InlineData("jellyfin web", "11.9.3")]
+    [InlineData("Jellyfin Web", "12.0")]
+    public void IsStaleWebClient_OlderJellyfinWebVersion_ReturnsTrue(string client, string version)
+    {
+        Assert.True(AuthorizationContext.IsStaleWebClient(client, version, ServerVersion));
+    }
+
+    [Theory]
+    [InlineData("Jellyfin Web", "12.1.0")] // same version, 3-part vs. the 4-part assembly version
+    [InlineData("Jellyfin Web", "12.1")] // same version, Build/Revision omitted entirely
+    [InlineData("Jellyfin Web", "12.2.0")]
+    [InlineData("Kodi", "12.0.0")]
+    [InlineData("Moonfin", "1.0.0")]
+    [InlineData("Jellyfin Web", null)]
+    [InlineData("Jellyfin Web", "not-a-version")]
+    [InlineData(null, "12.0.0")]
+    public void IsStaleWebClient_NotAnOlderWebClient_ReturnsFalse(string? client, string? version)
+    {
+        Assert.False(AuthorizationContext.IsStaleWebClient(client, version, ServerVersion));
+    }
+}
