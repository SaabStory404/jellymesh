+using System;
+using System.IO;
+using MediaBrowser.Controller.MediaEncoding;
+using Xunit;
+
+namespace Jellyfin.Controller.Tests.MediaEncoding;
+
+/// <summary>
+/// JellyMesh shared transcode dir: the cross-replica file contract (session keepalive, pool lease).
+/// </summary>
+public sealed class SharedTranscodeDirTests : IDisposable
+{
+    private const string Stem = "0123456789abcdef0123456789abcdef";
+
+    private readonly DirectoryInfo _dir = Directory.CreateTempSubdirectory(nameof(SharedTranscodeDirTests));
+
+    public void Dispose() => _dir.Delete(true);
+
+    [Theory]
+    [InlineData("abc123", true)]
+    [InlineData("0f1e2d3c-4b5a_x", true)]
+    [InlineData("", false)]
+    [InlineData(null, false)]
+    [InlineData("../etc", false)]
+    [InlineData("a/b", false)]
+    [InlineData("a b", false)]
+    public void GetKeepalivePath_OnlyForPlainTokens(string? playSessionId, bool expected)
+    {
+        var path = SharedTranscodeDir.GetKeepalivePath("/transcodes/jf", playSessionId);
+        Assert.Equal(expected, path is not null);
+        if (expected)
+        {
+            Assert.Equal(Path.Combine("/transcodes/jf", ".jellymesh-alive", playSessionId!), path);
+        }
+    }
+
+    [Fact]
+    public void GetKeepalivePath_RejectsOverlongIds()
+        => Assert.Null(SharedTranscodeDir.GetKeepalivePath("/t", new string('a', 129)));
+
+    [Fact]
+    public void Touch_WritesStateAndKeepsItWhenUnspecified()
+    {
+        var id = "touch" + Guid.NewGuid().ToString("N");
+        Assert.True(SharedTranscodeDir.Touch(_dir.FullName, id, true));
+        var path = SharedTranscodeDir.GetKeepalivePath(_dir.FullName, id);
+        var ka = SharedTranscodeDir.ReadKeepalive(path);
+        Assert.NotNull(ka);
+        Assert.True(ka.Value.Paused);
+        Assert.True(DateTime.UtcNow - ka.Value.TouchedUtc < TimeSpan.FromSeconds(5));
+
+        // Within the throttle window and no state change: skipped.
+        Assert.False(SharedTranscodeDir.Touch(_dir.FullName, id, null));
+        Assert.False(SharedTranscodeDir.Touch(_dir.FullName, id, true));
+
+        // A state change is always written, throttle or not.
+        Assert.True(SharedTranscodeDir.Touch(_dir.FullName, id, false));
+        Assert.False(SharedTranscodeDir.ReadKeepalive(path)!.Value.Paused);
+    }
+
+    [Fact]
+    public void Touch_IgnoresUnsafeSessionIds()
+        => Assert.False(SharedTranscodeDir.Touch(_dir.FullName, "../x", false));
+
+    [Fact]
+    public void ReadKeepalive_MissingFile_IsNull()
+    {
+        Assert.Null(SharedTranscodeDir.ReadKeepalive(Path.Combine(_dir.FullName, "nope")));
+        Assert.Null(SharedTranscodeDir.ReadKeepalive(null));
+    }
+
+    [Fact]
+    public void KeepaliveRemainingMs_UsesThePausedOrPlayingTimeout()
+    {
+        var now = new DateTime(2026, 9, 28, 12, 0, 0, DateTimeKind.Utc);
+        Assert.Equal(0, SharedTranscodeDir.KeepaliveRemainingMs(null, now, 60000, 180000));
+        Assert.Equal(50000, SharedTranscodeDir.KeepaliveRemainingMs((now.AddSeconds(-10), false), now, 60000, 180000));
+        Assert.Equal(0, SharedTranscodeDir.KeepaliveRemainingMs((now.AddSeconds(-61), false), now, 60000, 180000));
+
+        // A paused client that stopped pinging 100 s ago is still inside the paused grace.
+        Assert.Equal(80000, SharedTranscodeDir.KeepaliveRemainingMs((now.AddSeconds(-100), true), now, 60000, 180000));
+        Assert.Equal(0, SharedTranscodeDir.KeepaliveRemainingMs((now.AddSeconds(-181), true), now, 60000, 180000));
+
+        // Clock skew: a touch in the future counts as now, never more than the full timeout.
+        Assert.Equal(60000, SharedTranscodeDir.KeepaliveRemainingMs((now.AddSeconds(30), false), now, 60000, 180000));
+    }
+
+    [Theory]
+    [InlineData("jf-a:12:34", "jf-a", false)]
+    [InlineData("jf-b:12:34", "jf-a", true)]
+    [InlineData("jf-a", "jf-a", false)]
+    [InlineData("", "jf-a", true)]
+    [InlineData(null, "jf-a", true)]
+    public void IsForeignToken_ComparesTheHostPart(string? token, string host, bool expected)
+        => Assert.Equal(expected, SharedTranscodeDir.IsForeignToken(token, host));
+
+    [Fact]
+    public void GetLeasePath_IsTheStemSibling()
+        => Assert.Equal(
+            Path.Combine("/transcodes/jf", Stem + ".tcpool.lock"),
+            SharedTranscodeDir.GetLeasePath(Path.Combine("/transcodes/jf", Stem + ".m3u8")));
+
+    [Fact]
+    public void IsHeldByAnotherReplica_FreshForeignLeaseOnly()
+    {
+        var playlist = Path.Combine(_dir.FullName, Stem + ".m3u8");
+        var lease = SharedTranscodeDir.GetLeasePath(playlist);
+        var now = DateTime.UtcNow;
+
+        Assert.False(SharedTranscodeDir.IsHeldByAnotherReplica(playlist, now, "jf-a"));
+
+        File.WriteAllText(lease, "jf-b:1:2");
+        File.SetLastWriteTimeUtc(lease, now);
+        Assert.True(SharedTranscodeDir.IsHeldByAnotherReplica(playlist, now, "jf-a"));
+        Assert.False(SharedTranscodeDir.IsHeldByAnotherReplica(playlist, now, "jf-b"));
+        Assert.True(SharedTranscodeDir.IsLeaseFresh(playlist, now));
+
+        // Stale: the holder is gone, the output is nobody's.
+        File.SetLastWriteTimeUtc(lease, now.AddSeconds(-30));
+        Assert.False(SharedTranscodeDir.IsHeldByAnotherReplica(playlist, now, "jf-a"));
+        Assert.False(SharedTranscodeDir.IsLeaseFresh(playlist, now));
+    }
+
+    [Theory]
+    [InlineData(10, null, 4, false)] // no writer at all
+    [InlineData(10, 10, 4, false)] // at the writer's edge: wait
+    [InlineData(12, 10, 4, false)] // a little ahead: wait
+    [InlineData(15, 10, 4, true)] // past the restart gap
+    [InlineData(3, 10, 4, true)] // behind the writer, and the segment is missing
+    public void IsSeekAwayFromWriter_MatchesJellyfinsRestartRule(int requested, int? writer, int gap, bool expected)
+        => Assert.Equal(expected, SharedTranscodeDir.IsSeekAwayFromWriter(requested, writer, gap));
+
+    [Fact]
+    public void RecordSegmentRequest_WritesTheIndexNextToTheKeepalive()
+    {
+        var id = "pos" + Guid.NewGuid().ToString("N");
+        var path = SharedTranscodeDir.GetPositionPath(_dir.FullName, id);
+        Assert.Equal(SharedTranscodeDir.GetKeepalivePath(_dir.FullName, id) + ".seg", path);
+
+        Assert.True(SharedTranscodeDir.RecordSegmentRequest(_dir.FullName, id, 17));
+        // The pool agent parses the whole file as a plain decimal index.
+        Assert.Equal("17", File.ReadAllText(path!));
+        var first = SharedTranscodeDir.ReadPosition(path);
+        Assert.Equal(17, first!.Value.Index);
+        Assert.True(DateTime.UtcNow - first.Value.WrittenUtc < TimeSpan.FromMinutes(1));
+
+        // The same index again within the touch interval: skipped. A new index: written at once.
+        Assert.False(SharedTranscodeDir.RecordSegmentRequest(_dir.FullName, id, 17));
+        Assert.True(SharedTranscodeDir.RecordSegmentRequest(_dir.FullName, id, 18));
+        Assert.Equal(18, SharedTranscodeDir.ReadPosition(path)!.Value.Index);
+        // A seek back is a position too.
+        Assert.True(SharedTranscodeDir.RecordSegmentRequest(_dir.FullName, id, 3));
+        Assert.Equal(3, SharedTranscodeDir.ReadPosition(path)!.Value.Index);
+
+        // Written via a temporary file and a rename: nothing else is left behind.
+        var dir = Path.GetDirectoryName(path)!;
+        Assert.Empty(Directory.GetFiles(dir, Path.GetFileName(path) + ".tmp-*"));
+    }
+
+    [Fact]
+    public void RecordSegmentRequest_IgnoresInitSegmentsAndUnsafeIds()
+    {
+        Assert.False(SharedTranscodeDir.RecordSegmentRequest(_dir.FullName, "pos-init", -1));
+        Assert.Null(SharedTranscodeDir.ReadPosition(SharedTranscodeDir.GetPositionPath(_dir.FullName, "pos-init")));
+        Assert.False(SharedTranscodeDir.RecordSegmentRequest(_dir.FullName, "../x", 5));
+        Assert.Null(SharedTranscodeDir.GetPositionPath(_dir.FullName, "../x"));
+        Assert.Null(SharedTranscodeDir.ReadPosition(null));
+    }
+}
