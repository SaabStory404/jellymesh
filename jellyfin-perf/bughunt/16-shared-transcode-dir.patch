+using Xunit;
+
+namespace Jellyfin.MediaEncoding.Tests.Transcoding;
+
+/// <summary>
+/// Serializes the tests that flip JELLYMESH_SHARED_TRANSCODE_DIR (process-wide state).
+/// </summary>
+[CollectionDefinition(nameof(SharedTranscodeDirEnvCollection), DisableParallelization = true)]
+public sealed class SharedTranscodeDirEnvCollection
+{
+}
