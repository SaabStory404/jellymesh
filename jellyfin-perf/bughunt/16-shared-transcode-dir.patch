@@ -0,0 +1,189 @@
+using System;
+using System.IO;
+using System.Threading.Tasks;
+using MediaBrowser.Common.Configuration;
+using MediaBrowser.Controller.Configuration;
+using MediaBrowser.Controller.IO;
+using MediaBrowser.Controller.Library;
+using MediaBrowser.Controller.MediaEncoding;
+using MediaBrowser.Controller.Session;
+using MediaBrowser.MediaEncoding.Transcoding;
+using MediaBrowser.Model.Configuration;
+using MediaBrowser.Model.IO;
+using Microsoft.Extensions.Configuration;
+using Microsoft.Extensions.Logging.Abstractions;
+using Moq;
+using Xunit;
+
+namespace Jellyfin.MediaEncoding.Tests.Transcoding;
+
+/// <summary>
+/// JellyMesh shared transcode dir: the owner's kill timer honours a keepalive touched on another
+/// replica, and cleanup never deletes an output another replica's writer now owns.
+/// </summary>
+[Collection(nameof(SharedTranscodeDirEnvCollection))]
+public sealed class TranscodeManagerSharedDirTests : IDisposable
+{
+    private const string Stem = "0123456789abcdef0123456789abcdef";
+
+    private readonly DirectoryInfo _dir = Directory.CreateTempSubdirectory(nameof(TranscodeManagerSharedDirTests));
+    private readonly string? _originalFlag = Environment.GetEnvironmentVariable("JELLYMESH_SHARED_TRANSCODE_DIR");
+
+    public TranscodeManagerSharedDirTests()
+    {
+        Environment.SetEnvironmentVariable("JELLYMESH_SHARED_TRANSCODE_DIR", "1");
+    }
+
+    public void Dispose()
+    {
+        Environment.SetEnvironmentVariable("JELLYMESH_SHARED_TRANSCODE_DIR", _originalFlag);
+        _dir.Delete(true);
+    }
+
+    private (TranscodeManager Manager, Mock<IFileSystem> FileSystem) CreateManager()
+    {
+        var fileSystem = new Mock<IFileSystem>();
+        fileSystem.Setup(f => f.GetFilePaths(It.IsAny<string>(), true)).Returns(Array.Empty<string>());
+
+        var appPaths = Mock.Of<IApplicationPaths>();
+        var serverConfigurationManager = new Mock<IServerConfigurationManager>();
+        serverConfigurationManager.Setup(s => s.GetConfiguration("encoding")).Returns(new EncodingOptions { TranscodingTempPath = _dir.FullName });
+        serverConfigurationManager.Setup(s => s.CommonApplicationPaths).Returns(Mock.Of<IApplicationPaths>(a => a.CachePath == "/cache"));
+
+        var mediaEncoder = new Mock<IMediaEncoder>();
+        var encodingHelper = new EncodingHelper(
+            appPaths,
+            mediaEncoder.Object,
+            new Mock<ISubtitleEncoder>().Object,
+            new Mock<IConfiguration>().Object,
+            new Mock<MediaBrowser.Common.Configuration.IConfigurationManager>().Object,
+            new Mock<IPathManager>().Object);
+
+        var manager = new TranscodeManager(
+            NullLoggerFactory.Instance,
+            fileSystem.Object,
+            appPaths,
+            serverConfigurationManager.Object,
+            Mock.Of<IUserManager>(),
+            new Mock<ISessionManager>().Object,
+            encodingHelper,
+            mediaEncoder.Object,
+            Mock.Of<IMediaSourceManager>(),
+            Mock.Of<IAttachmentExtractor>());
+
+        return (manager, fileSystem);
+    }
+
+    private TranscodingJob CreateJob(string playSessionId)
+        => new(NullLogger<TranscodingJob>.Instance)
+        {
+            Path = Path.Combine(_dir.FullName, Stem + ".m3u8"),
+            Type = TranscodingJobType.Hls,
+            PlaySessionId = playSessionId
+        };
+
+    private void WriteKeepalive(string playSessionId, string state, DateTime touchedUtc)
+    {
+        var path = SharedTranscodeDir.GetKeepalivePath(_dir.FullName, playSessionId)!;
+        Directory.CreateDirectory(Path.GetDirectoryName(path)!);
+        File.WriteAllText(path, state);
+        File.SetLastWriteTimeUtc(path, touchedUtc);
+    }
+
+    [Fact]
+    public void KillTimer_KeepsAJobWhoseClientPingsAnotherReplica()
+    {
+        var (manager, _) = CreateManager();
+        var now = DateTime.UtcNow;
+        WriteKeepalive("sessplaying", "playing", now.AddSeconds(-10));
+
+        var remaining = manager.GetSharedKeepaliveRemainingMs(CreateJob("sessplaying"), now);
+
+        Assert.InRange(remaining, 49000, 50000);
+    }
+
+    [Fact]
+    public void KillTimer_PausedOnAnotherReplicaGetsThePausedGrace()
+    {
+        var (manager, _) = CreateManager();
+        var now = DateTime.UtcNow;
+
+        // 100 s without a ping would kill a playing session (60 s) but not a paused one (180 s).
+        WriteKeepalive("sesspaused", "paused", now.AddSeconds(-100));
+
+        var remaining = manager.GetSharedKeepaliveRemainingMs(CreateJob("sesspaused"), now);
+
+        Assert.InRange(remaining, 79000, 80000);
+    }
+
+    [Fact]
+    public void KillTimer_ProceedsWhenNobodySawTheClient()
+    {
+        var (manager, _) = CreateManager();
+        var now = DateTime.UtcNow;
+        WriteKeepalive("sessgone", "playing", now.AddSeconds(-61));
+
+        Assert.Equal(0, manager.GetSharedKeepaliveRemainingMs(CreateJob("sessgone"), now));
+        Assert.Equal(0, manager.GetSharedKeepaliveRemainingMs(CreateJob("sessnever"), now));
+    }
+
+    [Fact]
+    public void KillTimer_IgnoresTheKeepaliveWhenTheFlagIsOff()
+    {
+        var (manager, _) = CreateManager();
+        var now = DateTime.UtcNow;
+        WriteKeepalive("sessoff", "playing", now);
+        Environment.SetEnvironmentVariable("JELLYMESH_SHARED_TRANSCODE_DIR", null);
+
+        Assert.Equal(0, manager.GetSharedKeepaliveRemainingMs(CreateJob("sessoff"), now));
+    }
+
+    [Fact]
+    public void Ping_TouchesTheSharedKeepaliveWithoutALocalJob()
+    {
+        var (manager, _) = CreateManager();
+
+        manager.PingTranscodingJob("sessping", true);
+
+        var ka = SharedTranscodeDir.ReadKeepalive(SharedTranscodeDir.GetKeepalivePath(_dir.FullName, "sessping"));
+        Assert.NotNull(ka);
+        Assert.True(ka.Value.Paused);
+    }
+
+    [Fact]
+    public async Task DeletePartialStreamFiles_SkipsAnOutputAnotherReplicaOwns()
+    {
+        var (manager, fileSystem) = CreateManager();
+        var playlist = Path.Combine(_dir.FullName, Stem + ".m3u8");
+        var lease = SharedTranscodeDir.GetLeasePath(playlist);
+        await File.WriteAllTextAsync(lease, "some-other-replica:42:1", TestContext.Current.CancellationToken);
+        File.SetLastWriteTimeUtc(lease, DateTime.UtcNow);
+        fileSystem.Setup(f => f.GetFilePaths(_dir.FullName, false)).Returns(new[] { Path.Combine(_dir.FullName, Stem + "12.ts") });
+
+        await manager.DeletePartialStreamFiles(playlist, TranscodingJobType.Hls, 0, 0);
+
+        fileSystem.Verify(f => f.DeleteFile(It.IsAny<string>()), Times.Never);
+    }
+
+    [Fact]
+    public async Task DeletePartialStreamFiles_DeletesOwnOrUnleasedOutputs()
+    {
+        var (manager, fileSystem) = CreateManager();
+        var playlist = Path.Combine(_dir.FullName, Stem + ".m3u8");
+        var segment = Path.Combine(_dir.FullName, Stem + "12.ts");
+        fileSystem.Setup(f => f.GetFilePaths(_dir.FullName, false)).Returns(new[] { segment });
+
+        // Our own (fresh) lease: our job, our files.
+        var lease = SharedTranscodeDir.GetLeasePath(playlist);
+        await File.WriteAllTextAsync(lease, SharedTranscodeDir.HostName + ":42:1", TestContext.Current.CancellationToken);
+        File.SetLastWriteTimeUtc(lease, DateTime.UtcNow);
+        await manager.DeletePartialStreamFiles(playlist, TranscodingJobType.Hls, 0, 0);
+        fileSystem.Verify(f => f.DeleteFile(segment), Times.Once);
+
+        // A stale foreign lease: its holder is gone, the files are garbage.
+        await File.WriteAllTextAsync(lease, "some-other-replica:42:1", TestContext.Current.CancellationToken);
+        File.SetLastWriteTimeUtc(lease, DateTime.UtcNow.AddMinutes(-1));
+        await manager.DeletePartialStreamFiles(playlist, TranscodingJobType.Hls, 0, 0);
+        fileSystem.Verify(f => f.DeleteFile(segment), Times.Exactly(2));
+    }
+}
