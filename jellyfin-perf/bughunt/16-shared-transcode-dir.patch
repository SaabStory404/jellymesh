diff --git a/MediaBrowser.Controller/MediaEncoding/SharedTranscodeDir.cs b/MediaBrowser.Controller/MediaEncoding/SharedTranscodeDir.cs
new file mode 100644
index 000000000..864a1bdaa
--- /dev/null
+++ b/MediaBrowser.Controller/MediaEncoding/SharedTranscodeDir.cs
@@ -0,0 +1,389 @@
+using System;
+using System.Collections.Concurrent;
+using System.Globalization;
+using System.IO;
+using System.Linq;
+
+namespace MediaBrowser.Controller.MediaEncoding;
+
+/// <summary>
+/// JellyMesh shared transcode directory (JELLYMESH_SHARED_TRANSCODE_DIR=1): every Jellyfin
+/// replica uses one transcode directory, so a replica can serve (and outlive) segments another
+/// replica's job is writing. This class holds the cross-replica file contract Jellyfin needs:
+/// <list type="bullet">
+/// <item><description>a per-session keepalive file, <c>&lt;transcode dir&gt;/.jellymesh-alive/&lt;PlaySessionId&gt;</c>, touched by
+/// whichever replica receives a segment request or a progress ping for that session, and read by the owning
+/// replica's kill timer (and by a transcode-pool agent running a job whose replica died);</description></item>
+/// <item><description>the transcode pool's per-output lease, <c>&lt;stem&gt;.tcpool.lock</c> next to the playlist, whose holder token
+/// starts with the holder's host name. A fresh lease held by another host means another replica owns that output.</description></item>
+/// <item><description>a per-session viewer position, <c>&lt;keepalive&gt;.seg</c>: the index of the last segment any replica served a
+/// request for (mtime = when). A pool agent running a job whose replica died throttles it against this, as Jellyfin's own
+/// throttler would have.</description></item>
+/// </list>
+/// Everything here is a no-op unless the flag is set, and every file operation is best-effort:
+/// a failure falls back to stock (per-replica) behaviour, never to an exception on a request path.
+/// </summary>
+public static class SharedTranscodeDir
+{
+    /// <summary>
+    /// The environment variable set on every HLS ffmpeg (the transcode-pool shim) in shared mode,
+    /// naming the session keepalive file.
+    /// </summary>
+    public const string KeepaliveEnvironmentVariable = "JELLYMESH_KEEPALIVE";
+
+    /// <summary>
+    /// The keepalive directory's name under the transcode directory.
+    /// </summary>
+    public const string KeepaliveDirectoryName = ".jellymesh-alive";
+
+    /// <summary>
+    /// Appended to a keepalive path to name the session's viewer-position file.
+    /// </summary>
+    public const string PositionSuffix = ".seg";
+
+    /// <summary>
+    /// A pool lease older than this is dead (its holder heartbeats every second).
+    /// </summary>
+    public static readonly TimeSpan LeaseStaleAfter = TimeSpan.FromSeconds(6);
+
+    /// <summary>
+    /// Touches of the same session's keepalive closer together than this are skipped (NFS writes).
+    /// </summary>
+    public static readonly TimeSpan TouchInterval = TimeSpan.FromSeconds(2);
+
+    private static readonly ConcurrentDictionary<string, (DateTime AtUtc, bool Paused)> _lastTouch = new(StringComparer.Ordinal);
+
+    private static readonly ConcurrentDictionary<string, (DateTime AtUtc, int Index)> _lastPosition = new(StringComparer.Ordinal);
+
+    /// <summary>
+    /// Gets a value indicating whether shared transcode directory mode is on. Read on every call
+    /// (not cached) so tests can toggle it.
+    /// </summary>
+    public static bool Enabled => Environment.GetEnvironmentVariable("JELLYMESH_SHARED_TRANSCODE_DIR") == "1";
+
+    /// <summary>
+    /// Gets the host name this replica writes into pool lease tokens (the shim's <c>HOSTNAME</c>).
+    /// </summary>
+    public static string HostName => Environment.GetEnvironmentVariable("HOSTNAME") is { Length: > 0 } h ? h : Environment.MachineName;
+
+    /// <summary>
+    /// The keepalive file for a play session, or <c>null</c> when the session id is missing or not a
+    /// plain token (it becomes a file name).
+    /// </summary>
+    /// <param name="transcodePath">The transcode directory.</param>
+    /// <param name="playSessionId">The play session id.</param>
+    /// <returns>The keepalive path, or <c>null</c>.</returns>
+    public static string? GetKeepalivePath(string transcodePath, string? playSessionId)
+    {
+        if (string.IsNullOrEmpty(transcodePath)
+            || string.IsNullOrEmpty(playSessionId)
+            || playSessionId.Length > 128
+            || !playSessionId.All(c => char.IsAsciiLetterOrDigit(c) || c == '-' || c == '_'))
+        {
+            return null;
+        }
+
+        return Path.Combine(transcodePath, KeepaliveDirectoryName, playSessionId);
+    }
+
+    /// <summary>
+    /// Records that a client of this play session is alive (a segment request or a progress ping
+    /// reached this replica). <paramref name="isPaused"/> <c>null</c> keeps the last reported state.
+    /// Throttled per session to one write every <see cref="TouchInterval"/> unless the paused state changes.
+    /// </summary>
+    /// <param name="transcodePath">The transcode directory.</param>
+    /// <param name="playSessionId">The play session id.</param>
+    /// <param name="isPaused">Whether the client reported itself paused, if it said.</param>
+    /// <returns><c>true</c> if the file was written.</returns>
+    public static bool Touch(string transcodePath, string? playSessionId, bool? isPaused)
+    {
+        var path = GetKeepalivePath(transcodePath, playSessionId);
+        if (path is null)
+        {
+            return false;
+        }
+
+        var now = DateTime.UtcNow;
+        var known = _lastTouch.TryGetValue(path, out var last);
+        var paused = isPaused ?? (known && last.Paused);
+        if (known && paused == last.Paused && now - last.AtUtc < TouchInterval)
+        {
+            return false;
+        }
+
+        try
+        {
+            Directory.CreateDirectory(Path.GetDirectoryName(path)!);
+            if (!known || paused != last.Paused || !File.Exists(path))
+            {
+                File.WriteAllText(path, paused ? "paused" : "playing");
+            }
+
+            // Explicit, not implied by the write: the reader compares this against its own clock.
+            File.SetLastWriteTimeUtc(path, now);
+            _lastTouch[path] = (now, paused);
+            if (_lastTouch.Count > 4096)
+            {
+                PruneTouchCache(now);
+            }
+
+            return true;
+        }
+        catch (Exception ex) when (ex is IOException or UnauthorizedAccessException)
+        {
+            return false;
+        }
+    }
+
+    /// <summary>
+    /// Reads a keepalive file: when it was last touched and whether the client last reported paused.
+    /// </summary>
+    /// <param name="path">The keepalive path.</param>
+    /// <returns>The state, or <c>null</c> if the file does not exist or cannot be read.</returns>
+    public static (DateTime TouchedUtc, bool Paused)? ReadKeepalive(string? path)
+    {
+        if (path is null)
+        {
+            return null;
+        }
+
+        try
+        {
+            if (!File.Exists(path))
+            {
+                return null;
+            }
+
+            var touched = File.GetLastWriteTimeUtc(path);
+            var paused = File.ReadAllText(path).StartsWith("paused", StringComparison.Ordinal);
+            return (touched, paused);
+        }
+        catch (Exception ex) when (ex is IOException or UnauthorizedAccessException)
+        {
+            return null;
+        }
+    }
+
+    /// <summary>
+    /// The viewer-position file for a play session (<c>&lt;keepalive&gt;.seg</c>), or <c>null</c> when
+    /// the session id is not usable (see <see cref="GetKeepalivePath"/>).
+    /// </summary>
+    /// <param name="transcodePath">The transcode directory.</param>
+    /// <param name="playSessionId">The play session id.</param>
+    /// <returns>The position path, or <c>null</c>.</returns>
+    public static string? GetPositionPath(string transcodePath, string? playSessionId)
+        => GetKeepalivePath(transcodePath, playSessionId) is { } keepalive ? keepalive + PositionSuffix : null;
+
+    /// <summary>
+    /// Records the segment a client of this play session just requested, on whichever replica got
+    /// the request. The transcode-pool agent throttles a job whose replica died against it. Written
+    /// to a temporary file and renamed (a reader never sees a torn value); rewritten whenever the
+    /// index changes, otherwise at most every <see cref="TouchInterval"/>.
+    /// </summary>
+    /// <param name="transcodePath">The transcode directory.</param>
+    /// <param name="playSessionId">The play session id.</param>
+    /// <param name="segmentIndex">The requested segment index (negative, e.g. an fMP4 init segment, is ignored).</param>
+    /// <returns><c>true</c> if the file was written.</returns>
+    public static bool RecordSegmentRequest(string transcodePath, string? playSessionId, int segmentIndex)
+    {
+        var path = segmentIndex < 0 ? null : GetPositionPath(transcodePath, playSessionId);
+        if (path is null)
+        {
+            return false;
+        }
+
+        var now = DateTime.UtcNow;
+        if (_lastPosition.TryGetValue(path, out var last) && last.Index == segmentIndex && now - last.AtUtc < TouchInterval)
+        {
+            return false;
+        }
+
+        var temp = path + ".tmp-" + Environment.ProcessId.ToString(CultureInfo.InvariantCulture);
+        try
+        {
+            Directory.CreateDirectory(Path.GetDirectoryName(path)!);
+            File.WriteAllText(temp, segmentIndex.ToString(CultureInfo.InvariantCulture));
+            File.SetLastWriteTimeUtc(temp, now);
+            File.Move(temp, path, true);
+            _lastPosition[path] = (now, segmentIndex);
+            if (_lastPosition.Count > 4096)
+            {
+                PruneTouchCache(now);
+            }
+
+            return true;
+        }
+        catch (Exception ex) when (ex is IOException or UnauthorizedAccessException)
+        {
+            try
+            {
+                File.Delete(temp);
+            }
+            catch (Exception cleanup) when (cleanup is IOException or UnauthorizedAccessException)
+            {
+                // best effort
+            }
+
+            return false;
+        }
+    }
+
+    /// <summary>
+    /// Reads a viewer-position file.
+    /// </summary>
+    /// <param name="path">The position path.</param>
+    /// <returns>The segment index and when it was written, or <c>null</c> if missing or unreadable.</returns>
+    public static (int Index, DateTime WrittenUtc)? ReadPosition(string? path)
+    {
+        if (path is null)
+        {
+            return null;
+        }
+
+        try
+        {
+            if (!File.Exists(path)
+                || !int.TryParse(File.ReadAllText(path).Trim(), NumberStyles.Integer, CultureInfo.InvariantCulture, out var index))
+            {
+                return null;
+            }
+
+            return (index, File.GetLastWriteTimeUtc(path));
+        }
+        catch (Exception ex) when (ex is IOException or UnauthorizedAccessException)
+        {
+            return null;
+        }
+    }
+
+    /// <summary>
+    /// How much longer a job must be kept alive because of its session keepalive: the keepalive's
+    /// age measured against the kill timeout that applies to it (<paramref name="pausedTimeoutMs"/>
+    /// when the last touch said paused). Zero or less means no replica has seen the client recently.
+    /// </summary>
+    /// <param name="keepalive">The keepalive state, if any.</param>
+    /// <param name="utcNow">The current time.</param>
+    /// <param name="playingTimeoutMs">The kill timeout for a playing client.</param>
+    /// <param name="pausedTimeoutMs">The kill timeout for a paused client.</param>
+    /// <returns>Milliseconds left, or zero.</returns>
+    public static int KeepaliveRemainingMs((DateTime TouchedUtc, bool Paused)? keepalive, DateTime utcNow, int playingTimeoutMs, int pausedTimeoutMs)
+    {
+        if (keepalive is not { } k)
+        {
+            return 0;
+        }
+
+        var timeout = k.Paused ? pausedTimeoutMs : playingTimeoutMs;
+
+        // A touch "in the future" (clock skew between replicas) counts as now.
+        var age = Math.Max(0, (utcNow - k.TouchedUtc).TotalMilliseconds);
+        return (int)Math.Max(0, Math.Min(timeout, timeout - age));
+    }
+
+    /// <summary>
+    /// The pool lease file for an HLS output: <c>&lt;dir&gt;/&lt;stem&gt;.tcpool.lock</c>.
+    /// </summary>
+    /// <param name="outputPath">The playlist (or any file named after the output stem).</param>
+    /// <returns>The lease path.</returns>
+    public static string GetLeasePath(string outputPath)
+        => Path.Combine(Path.GetDirectoryName(outputPath) ?? string.Empty, Path.GetFileNameWithoutExtension(outputPath) + ".tcpool.lock");
+
+    /// <summary>
+    /// Whether the lease token names another host (tokens are <c>host:pid:nanos</c>). An empty or
+    /// unreadable token cannot be proven ours, so it counts as foreign.
+    /// </summary>
+    /// <param name="token">The lease file's content.</param>
+    /// <param name="ownHost">This replica's host name.</param>
+    /// <returns><c>true</c> if the token belongs to another host.</returns>
+    public static bool IsForeignToken(string? token, string ownHost)
+    {
+        if (string.IsNullOrEmpty(token))
+        {
+            return true;
+        }
+
+        var sep = token.IndexOf(':', StringComparison.Ordinal);
+        var host = sep < 0 ? token : token[..sep];
+        return !string.Equals(host, ownHost, StringComparison.Ordinal);
+    }
+
+    /// <summary>
+    /// Whether another replica currently owns an HLS output: its pool lease is fresh and not ours.
+    /// Used to keep this replica's cleanup away from files another replica's writer is producing
+    /// under the same (session-derived) name.
+    /// </summary>
+    /// <param name="outputPath">The playlist path.</param>
+    /// <param name="utcNow">The current time.</param>
+    /// <param name="ownHost">This replica's host name; <see cref="HostName"/> when <c>null</c>.</param>
+    /// <returns><c>true</c> if another replica holds a fresh lease on the output.</returns>
+    public static bool IsHeldByAnotherReplica(string outputPath, DateTime utcNow, string? ownHost = null)
+    {
+        var lease = GetLeasePath(outputPath);
+        try
+        {
+            if (!File.Exists(lease) || utcNow - File.GetLastWriteTimeUtc(lease) > LeaseStaleAfter)
+            {
+                return false;
+            }
+
+            return IsForeignToken(File.ReadAllText(lease), ownHost ?? HostName);
+        }
+        catch (Exception ex) when (ex is IOException or UnauthorizedAccessException)
+        {
+            // It existed a moment ago and we cannot read it: do not delete on a guess.
+            return true;
+        }
+    }
+
+    /// <summary>
+    /// Whether a fresh pool lease exists on an HLS output (anyone's). A pool writer publishes
+    /// segments with <c>temp_file</c>, so an existing segment under a fresh lease is complete.
+    /// </summary>
+    /// <param name="outputPath">The playlist path.</param>
+    /// <param name="utcNow">The current time.</param>
+    /// <returns><c>true</c> if the lease is fresh.</returns>
+    public static bool IsLeaseFresh(string outputPath, DateTime utcNow)
+    {
+        var lease = GetLeasePath(outputPath);
+        try
+        {
+            return File.Exists(lease) && utcNow - File.GetLastWriteTimeUtc(lease) <= LeaseStaleAfter;
+        }
+        catch (Exception ex) when (ex is IOException or UnauthorizedAccessException)
+        {
+            return false;
+        }
+    }
+
+    /// <summary>
+    /// Whether a request with no local job for its playlist is a seek relative to what another
+    /// writer is producing: behind the writer's newest segment (that segment is missing, or it
+    /// would have been served), or further ahead than Jellyfin's own restart gap. Such a request
+    /// must restart the transcode at once instead of waiting for the writer to get there.
+    /// </summary>
+    /// <param name="requestedSegment">The requested segment index.</param>
+    /// <param name="writerSegment">The newest segment index on disk, if any.</param>
+    /// <param name="maxGap">Jellyfin's restart gap (<c>24 / SegmentLength</c>).</param>
+    /// <returns><c>true</c> if the request should restart the transcode.</returns>
+    public static bool IsSeekAwayFromWriter(int requestedSegment, int? writerSegment, int maxGap)
+        => writerSegment is { } w && (requestedSegment < w || requestedSegment - w > maxGap);
+
+    private static void PruneTouchCache(DateTime utcNow)
+    {
+        foreach (var entry in _lastTouch)
+        {
+            if (utcNow - entry.Value.AtUtc > TimeSpan.FromMinutes(10))
+            {
+                _lastTouch.TryRemove(entry.Key, out _);
+            }
+        }
+
+        foreach (var entry in _lastPosition)
+        {
+            if (utcNow - entry.Value.AtUtc > TimeSpan.FromMinutes(10))
+            {
+                _lastPosition.TryRemove(entry.Key, out _);
+            }
+        }
+    }
+}
