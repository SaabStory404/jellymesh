+    /// <summary>
+    /// Decides whether a request that found no transcoding job tracked on this node for a
+    /// playlist should wait for the requested segment instead of starting a brand new ffmpeg
+    /// process. A local job is authoritative when one exists; when it does not, the only
+    /// signal that can cross a node boundary in a deployment where several nodes share one
+    /// transcode directory is the directory itself. A segment file for this playlist written
+    /// very recently means some process -- possibly on another node -- is actively producing
+    /// this stream right now, so starting a second ffmpeg against the same output path would
+    /// race it. A stale file, or no file at all, means nothing is producing this stream, so
+    /// starting fresh is the correct and necessary recovery.
+    /// </summary>
+    /// <param name="lastSegmentWriteTimeUtc">The last-write time of the most recent segment file for this playlist, if any exists.</param>
+    /// <param name="utcNow">The current time.</param>
+    /// <param name="maxWriterAge">How recent that write must be to be treated as an active writer.</param>
+    /// <returns><c>true</c> if the request should wait for the segment instead of starting a new transcode.</returns>
+    internal static bool ShouldWaitForOtherWriter(DateTime? lastSegmentWriteTimeUtc, DateTime utcNow, TimeSpan maxWriterAge)
+    {
+        return lastSegmentWriteTimeUtc.HasValue && (utcNow - lastSegmentWriteTimeUtc.Value) <= maxWriterAge;
+    }
+
+    /// <summary>
+    /// The actual gate GetDynamicSegment uses before it will even look at the shared transcode
+    /// directory for another writer's output: a local job is authoritative when one exists
+    /// (nothing to check), and even with no local job, the whole foreign-file check is skipped
+    /// unless JELLYMESH_SHARED_TRANSCODE_DIR opted in (see <see cref="SharedTranscodeDirEnabled"/>).
+    /// Extracted to its own testable unit so flag-off can be asserted directly against the same
+    /// condition the controller branches on, rather than reconstructed in a test.
+    /// </summary>
+    /// <param name="currentJob">The transcoding job this node has tracked for the playlist, if any.</param>
+    /// <returns><c>true</c> if GetDynamicSegment should go on to check the shared directory for a fresh foreign segment.</returns>
+    internal static bool ShouldCheckForOtherWriter(TranscodingJob? currentJob)
+    {
+        return SharedTranscodeDirEnabled && currentJob is null;
+    }
+
+    /// <summary>
+    /// Polls for a segment believed to be produced by a transcode this node is not tracking
+    /// (e.g. owned by another node sharing the same transcode directory). Mirrors the
+    /// readiness check <see cref="GetSegmentResult(StreamState, string, string, string, int, TranscodingJob?, CancellationToken)"/>
+    /// already uses when it does hold a job: a segment is only considered ready once the
+    /// *next* segment has also appeared, since some encoders write a segment's file in place
+    /// (no <c>temp_file</c> flag) and it can be visible as existing on disk before it is
+    /// complete.
+    /// </summary>
+    internal static async Task<bool> WaitForSegmentFromOtherWriter(string segmentPath, string nextSegmentPath, TimeSpan timeout, CancellationToken cancellationToken)
+    {
+        var deadline = DateTime.UtcNow + timeout;
+        while (!(System.IO.File.Exists(segmentPath) && System.IO.File.Exists(nextSegmentPath)))
+        {
+            if (DateTime.UtcNow >= deadline)
+            {
+                return false;
+            }
+
+            await Task.Delay(100, cancellationToken).ConfigureAwait(false);
+        }
+
+        return true;
+    }
+
     private static double[] GetSegmentLengths(StreamState state)
         => GetSegmentLengthsInternal(state.RunTimeTicks ?? 0, state.SegmentLength);
 
