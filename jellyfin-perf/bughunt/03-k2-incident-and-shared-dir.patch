+        [Fact]
+        public void ShouldWaitForOtherWriter_RecentFile_ReturnsTrue()
+        {
+            var utcNow = new DateTime(2026, 9, 27, 12, 0, 0, DateTimeKind.Utc);
+            var lastWrite = utcNow - TimeSpan.FromSeconds(3);
+
+            Assert.True(DynamicHlsController.ShouldWaitForOtherWriter(lastWrite, utcNow, TimeSpan.FromSeconds(6)));
+        }
