+        [Fact]
+        public void ShouldWaitForOtherWriter_NoFile_ReturnsFalse()
+        {
+            var utcNow = new DateTime(2026, 9, 27, 12, 0, 0, DateTimeKind.Utc);
+
+            Assert.False(DynamicHlsController.ShouldWaitForOtherWriter(null, utcNow, TimeSpan.FromSeconds(6)));
+        }
