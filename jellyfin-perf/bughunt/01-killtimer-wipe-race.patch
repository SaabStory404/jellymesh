+using System.Collections.Generic;
+using System.Threading.Tasks;
+using MediaBrowser.Common.Configuration;
+using MediaBrowser.Controller.Configuration;
+using MediaBrowser.Controller.IO;
+using MediaBrowser.Controller.Library;
+using MediaBrowser.Controller.MediaEncoding;
+using MediaBrowser.Controller.Session;
+using MediaBrowser.MediaEncoding.Transcoding;
+using MediaBrowser.Model.Configuration;
+using MediaBrowser.Model.IO;
+using Microsoft.Extensions.Configuration;
+using Microsoft.Extensions.Logging.Abstractions;
+using Moq;
+using Xunit;
+
+namespace Jellyfin.MediaEncoding.Tests.Transcoding;
+
+/// <summary>
+/// Regression tests for the kill-timer's deferred stream-file delete racing a replacement
+/// transcoding job started for the same output path (killtimer-wipe-race).
+/// </summary>
+public class TranscodeManagerTests
+{
+    private const string PlaylistPath = "/transcodes/deadbeefdeadbeefdeadbeefdeadbeef.m3u8";
+
+    private static (TranscodeManager Manager, Mock<IFileSystem> FileSystem) CreateManager()
+    {
+        var fileSystem = new Mock<IFileSystem>();
+
+        // No files on disk for DeleteEncodedMediaCache's startup scan to trip over.
+        fileSystem.Setup(f => f.GetFilePaths(It.IsAny<string>(), true)).Returns(System.Array.Empty<string>());
+
+        var appPaths = Mock.Of<IApplicationPaths>();
+        var serverConfigurationManager = new Mock<IServerConfigurationManager>();
+
+        // TranscodeManager's constructor calls DeleteEncodedMediaCache -> GetTranscodePath(), an
+        // extension method over these two real interface members.
+        serverConfigurationManager.Setup(s => s.GetConfiguration("encoding")).Returns(new EncodingOptions());
+        serverConfigurationManager.Setup(s => s.CommonApplicationPaths).Returns(Mock.Of<IApplicationPaths>(a => a.CachePath == "/cache"));
+
+        var mediaEncoder = new Mock<IMediaEncoder>();
+        var subtitleEncoder = new Mock<ISubtitleEncoder>();
+        var config = new Mock<IConfiguration>();
+        var configurationManager = new Mock<MediaBrowser.Common.Configuration.IConfigurationManager>();
+        var pathManager = new Mock<IPathManager>();
+        var encodingHelper = new EncodingHelper(
+            appPaths,
+            mediaEncoder.Object,
+            subtitleEncoder.Object,
+            config.Object,
+            configurationManager.Object,
+            pathManager.Object);
+
+        var manager = new TranscodeManager(
+            NullLoggerFactory.Instance,
+            fileSystem.Object,
+            appPaths,
+            serverConfigurationManager.Object,
+            Mock.Of<IUserManager>(),
+            new Mock<ISessionManager>().Object,
+            encodingHelper,
+            mediaEncoder.Object,
+            Mock.Of<IMediaSourceManager>(),
+            Mock.Of<IAttachmentExtractor>());
+
+        return (manager, fileSystem);
+    }
+
+    private static TranscodingJob CreateJob(string path, TranscodingJobType type)
+        => new(NullLogger<TranscodingJob>.Instance)
+        {
+            Path = path,
+            Type = type
+        };
+
+    [Fact]
+    public async Task DeletePartialStreamFiles_SkipsDelete_WhenReplacementJobRegisteredForSamePath()
+    {
+        var (manager, fileSystem) = CreateManager();
+
+        // Simulate DynamicHlsController's restart-on-retry: a replacement job for the exact
+        // same playlist path is registered again before the kill timer's deferred delete runs.
+        manager.AddActiveTranscodingJobForTests(CreateJob(PlaylistPath, TranscodingJobType.Hls));
+
+        fileSystem
+            .Setup(f => f.GetFilePaths(It.IsAny<string>(), false))
+            .Returns(new[] { PlaylistPath });
+
+        await manager.DeletePartialStreamFiles(PlaylistPath, TranscodingJobType.Hls, 0, 0);
+
+        fileSystem.Verify(f => f.DeleteFile(It.IsAny<string>()), Times.Never);
+    }
+
+    [Fact]
+    public async Task DeletePartialStreamFiles_Deletes_WhenNoReplacementJobRegistered()
+    {
+        var (manager, fileSystem) = CreateManager();
+
+        var otherFile = "/transcodes/deadbeefdeadbeefdeadbeefdeadbeef1.ts";
+        fileSystem
+            .Setup(f => f.GetFilePaths(It.IsAny<string>(), false))
+            .Returns(new[] { PlaylistPath, otherFile });
+
+        await manager.DeletePartialStreamFiles(PlaylistPath, TranscodingJobType.Hls, 0, 0);
+
+        fileSystem.Verify(f => f.DeleteFile(PlaylistPath), Times.Once);
+        fileSystem.Verify(f => f.DeleteFile(otherFile), Times.Once);
+    }
+
+    [Fact]
+    public void IsPathInUseByActiveJob_MatchesOnPathAndType()
+    {
+        var (manager, _) = CreateManager();
+
+        manager.AddActiveTranscodingJobForTests(CreateJob(PlaylistPath, TranscodingJobType.Hls));
+
+        Assert.True(manager.IsPathInUseByActiveJob(PlaylistPath, TranscodingJobType.Hls));
+
+        // A different type at the same path (e.g. a stale Progressive job) does not count as the
+        // same job, matching KillTranscodingJob's own GetTranscodingJob(path, type) lookup key.
+        Assert.False(manager.IsPathInUseByActiveJob(PlaylistPath, TranscodingJobType.Progressive));
+
+        Assert.False(manager.IsPathInUseByActiveJob("/transcodes/other.m3u8", TranscodingJobType.Hls));
+    }
+}
