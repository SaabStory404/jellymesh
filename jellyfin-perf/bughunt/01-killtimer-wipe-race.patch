+    /// <summary>
+    /// Returns whether a transcoding job with the given path and type is currently registered, i.e.
+    /// whether some job other than the one being torn down now owns this output path.
+    /// </summary>
+    /// <param name="path">The output path to check.</param>
+    /// <param name="type">The transcoding job type to check.</param>
+    /// <returns><c>true</c> if a matching job is registered; otherwise <c>false</c>.</returns>
+    internal bool IsPathInUseByActiveJob(string path, TranscodingJobType type)
+    {
+        lock (_activeTranscodingJobs)
+        {
+            return _activeTranscodingJobs.Any(j => j.Type == type && string.Equals(j.Path, path, StringComparison.OrdinalIgnoreCase));
+        }
+    }
+
+    /// <summary>
+    /// Test seam: registers a job directly into the active job list, bypassing process startup.
+    /// Production code always adds jobs through <see cref="OnTranscodeBeginning"/> (via <see cref="StartFfMpeg"/>).
+    /// </summary>
+    /// <param name="job">The job to register.</param>
+    internal void AddActiveTranscodingJobForTests(TranscodingJob job)
+    {
+        lock (_activeTranscodingJobs)
+        {
+            _activeTranscodingJobs.Add(job);
+        }
+    }
