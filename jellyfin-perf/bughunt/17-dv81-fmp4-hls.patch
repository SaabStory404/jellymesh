+        /// <summary>
+        /// JELLYMESH_DOVI_P7_TO_81 (bughunt 17): whether an HLS job built from
+        /// <paramref name="transcodingProfile"/> (segments in <paramref name="container"/>) will have
+        /// EncodingHelper convert the profile-7 source to profile 8.1. Mirrors
+        /// EncodingHelper.ShouldRemoveDynamicHdrMetadata's ConvertDoviP7ToP81 case on the range
+        /// types this StreamInfo will send (the "&lt;codec&gt;-rangetype" option that
+        /// BuildStreamVideoItem derives from the applicable video CodecProfile conditions): the
+        /// flag is on, the source is DOVIWithEL (not DOVIWithELHDR10Plus), the source codec can be
+        /// copied, and the declared ranges include DOVI or DOVIWithHDR10 but not DOVIWithEL.
+        /// </summary>
+        private bool WillConvertDoviP7ToP81(MediaOptions options, MediaSourceInfo item, MediaStream? videoStream, TranscodingProfile transcodingProfile, string container)
+        {
+            if (!DoviP7ToP81Enabled
+                || transcodingProfile.Protocol != MediaStreamProtocol.hls
+                || videoStream is null
+                || videoStream.VideoRangeType != VideoRangeType.DOVIWithEL
+                || !options.AllowVideoStreamCopy
+                || string.IsNullOrEmpty(videoStream.Codec)
+                || !ContainerHelper.ContainsContainer(transcodingProfile.VideoCodec, videoStream.Codec))
+            {
+                return false;
+            }
+
+            var codec = videoStream.Codec;
+
+            // Same selection and order as BuildStreamVideoItem's appliedVideoConditions, applied to a
+            // scratch StreamInfo so only the resulting rangetype option is read.
+            var scratch = new StreamInfo { DeviceProfile = options.Profile };
+            var applied = options.Profile.CodecProfiles
+                .Where(i => i.Type == CodecType.Video
+                    && i.ContainsAnyCodec(codec, container, true)
+                    && !CheckVideoConditions(i.ApplyConditions, item, videoStream).Any())
+                .Reverse();
+            foreach (var codecProfile in applied)
+            {
+                ApplyTranscodingConditions(scratch, codecProfile.Conditions, codec, true, true);
+            }
+
+            var rangeTypes = ContainerHelper.Split(scratch.GetOption(codec, "rangetype"));
+            bool Has(VideoRangeType t) => rangeTypes.Contains(t.ToString(), StringComparer.OrdinalIgnoreCase);
+
+            return !Has(VideoRangeType.DOVIWithEL) && (Has(VideoRangeType.DOVI) || Has(VideoRangeType.DOVIWithHDR10));
+        }
+
+        /// <summary>
+        /// Bughunt 17: whether BuildStreamVideoItem, called for an HLS item with segments in
+        /// <paramref name="container"/>, would copy the audio stream rather than transcode it (or
+        /// there is no audio). The same checks, in the same order, as its audio part.
+        /// </summary>
+        private bool WillCopyAudio(MediaOptions options, MediaSourceInfo item, MediaStream? audioStream, IEnumerable<MediaStream> candidateAudioStreams, StreamInfo playlistItem, string? profileAudioCodecs, string container)
+        {
+            if (audioStream is null)
+            {
+                return true;
+            }
+
+            var audioCodecs = ContainerHelper.Split(profileAudioCodecs).ToList();
+            if (audioCodecs.Count == 0)
+            {
+                audioCodecs.Add(audioStream.Codec);
+            }
+
+            var hlsAudioCodecs = string.Equals(container, "mp4", StringComparison.OrdinalIgnoreCase) ? _supportedHlsAudioCodecsMp4 : _supportedHlsAudioCodecsTs;
+            audioCodecs = audioCodecs.Where(codec => hlsAudioCodecs.Contains(codec)).ToList();
+
+            var stream = candidateAudioStreams.FirstOrDefault(s => ContainerHelper.ContainsContainer(audioCodecs, false, s.Codec));
+            return stream is not null
+                && !(stream.Channels > (playlistItem.TranscodingMaxAudioChannels ?? int.MaxValue))
+                && GetCompatibilityAudioCodec(options, item, container, stream, null, true, false) == 0
+                && !playlistItem.TranscodeReasons.HasFlag(TranscodeReason.ContainerBitrateExceedsLimit);
+        }
