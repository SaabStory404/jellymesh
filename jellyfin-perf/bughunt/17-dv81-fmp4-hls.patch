diff --git a/tests/Jellyfin.Model.Tests/Dlna/StreamBuilderDoviP7ToP81Fmp4Tests.cs b/tests/Jellyfin.Model.Tests/Dlna/StreamBuilderDoviP7ToP81Fmp4Tests.cs
new file mode 100644
--- /dev/null
+++ b/tests/Jellyfin.Model.Tests/Dlna/StreamBuilderDoviP7ToP81Fmp4Tests.cs
@@ -0,0 +1,250 @@
+using System;
+using Jellyfin.Data.Enums;
+using MediaBrowser.Model.Dlna;
+using MediaBrowser.Model.Dto;
+using MediaBrowser.Model.Entities;
+using MediaBrowser.Model.MediaInfo;
+using MediaBrowser.Model.Session;
+using Microsoft.Extensions.Logging.Abstractions;
+using Moq;
+using Xunit;
+
+namespace Jellyfin.Model.Tests.Dlna;
+
+/// <summary>
+/// JELLYMESH_DOVI_P7_TO_81, bughunt 17: a profile-7 source that the HLS job will convert to
+/// profile 8.1 is served as fMP4 segments even when the client's only HLS TranscodingProfile is
+/// "ts", and the TrueHD track the client declares is then kept (the TS-only HLS audio list drops
+/// it). The device profile is shaped like the Android TV app's (0.19.x deviceProfile.kt): one hls/ts
+/// TranscodingProfile listing truehd among its audio codecs, and an HEVC CodecProfile that rejects
+/// the unsupported range types with a NotEquals condition gated by an EqualsAny ApplyCondition.
+/// </summary>
+// Same collection as the other JELLYMESH_DOVI_P7_TO_81 test class: both set that process-wide
+// environment variable, so they must not run in parallel with each other.
+[Collection("JELLYMESH_DOVI_P7_TO_81 env")]
+public class StreamBuilderDoviP7ToP81Fmp4Tests
+{
+    private const string DoviCapableExcluded = "DOVIInvalid|DOVIWithEL|DOVIWithELHDR10Plus";
+
+    [Fact]
+    public void ConvertedSource_TsProfile_ServedAsFmp4_WithTrueHdCopied()
+    {
+        var info = Build(enabled: true, DoviCapableExcluded);
+
+        Assert.NotNull(info);
+        Assert.Equal(PlayMethod.Transcode, info.PlayMethod);
+        Assert.Equal(MediaStreamProtocol.hls, info.SubProtocol);
+        Assert.Equal("mp4", info.Container, StringComparer.OrdinalIgnoreCase);
+        Assert.Equal(["truehd"], info.AudioCodecs);
+        Assert.Equal(1, info.AudioStreamIndex);
+        Assert.False(info.TranscodeReasons.HasFlag(TranscodeReason.AudioCodecNotSupported));
+
+        // The copy must not be refused later for bitrate (EncodingHelper compares the source
+        // bitrate with the AudioBitrate the URL carries).
+        Assert.True(info.AudioBitrate is null || info.AudioBitrate >= 4_000_000, "AudioBitrate " + info.AudioBitrate);
+
+        var url = info.ToUrl("http://server", "token", null);
+        Assert.Contains("SegmentContainer=mp4", url, StringComparison.OrdinalIgnoreCase);
+        Assert.Contains("AudioCodec=truehd", url, StringComparison.OrdinalIgnoreCase);
+        Assert.Contains("DOVIWithHDR10", url, StringComparison.Ordinal);
+    }
+
+    [Fact]
+    public void ConvertedSource_AudioTranscoded_StaysOnTs()
+    {
+        // No audio stream may be copied here, so the audio would be encoded. Jellyfin's fMP4 argv
+        // starts an encoded track at a negative tfdt (encoder priming), which media3 cannot parse,
+        // and this profile's mp4 audio list ("aac,ac3,alac,dts,eac3,flac,mp3,opus,truehd", 42
+        // characters) is longer than DynamicHlsController's 40-character AudioCodec limit. So the
+        // job stays on TS (HDR10, as before) with the TS audio targets.
+        var info = Build(enabled: true, DoviCapableExcluded, noDefaultAudio: true);
+
+        Assert.NotNull(info);
+        Assert.Equal(PlayMethod.Transcode, info.PlayMethod);
+        Assert.Equal("ts", info.Container, StringComparer.OrdinalIgnoreCase);
+        Assert.Equal(["aac", "ac3", "eac3", "mp3"], info.AudioCodecs);
+    }
+
+    [Fact]
+    public void ConvertedSource_Ac3TrackChosen_ServedAsFmp4_WithAc3Copied()
+    {
+        var info = Build(enabled: true, DoviCapableExcluded, audioStreamIndex: 2);
+
+        Assert.NotNull(info);
+        Assert.Equal("mp4", info.Container, StringComparer.OrdinalIgnoreCase);
+        Assert.Equal(["ac3"], info.AudioCodecs);
+        Assert.Equal(2, info.AudioStreamIndex);
+    }
+
+    [Fact]
+    public void FlagOff_KeepsTs_AndTsAudioList()
+    {
+        var info = Build(enabled: false, DoviCapableExcluded);
+
+        Assert.NotNull(info);
+        Assert.Equal("ts", info.Container, StringComparer.OrdinalIgnoreCase);
+        Assert.DoesNotContain("truehd", info.AudioCodecs);
+    }
+
+    [Fact]
+    public void ClientDeclaringDoviWithEL_GetsUntouchedCopy_KeepsTs()
+    {
+        // The profile-7 stream is acceptable as is: Direct Play, no HLS job, no conversion.
+        var info = Build(enabled: true, "DOVIInvalid");
+
+        Assert.NotNull(info);
+        Assert.Equal(PlayMethod.DirectPlay, info.PlayMethod);
+        Assert.Equal("mkv", info.Container, StringComparer.OrdinalIgnoreCase);
+
+        // Forced through the HLS path (no Direct Play profile), the client still takes the
+        // untouched profile-7 copy, so the segments stay TS.
+        var hls = Build(enabled: true, "DOVIInvalid", directPlay: false);
+        Assert.NotNull(hls);
+        Assert.Equal(PlayMethod.Transcode, hls.PlayMethod);
+        Assert.Equal("ts", hls.Container, StringComparer.OrdinalIgnoreCase);
+    }
+
+    [Fact]
+    public void Hdr10OnlyClient_KeepsTs()
+    {
+        // Stripped to HDR10 server-side, not converted.
+        var info = Build(enabled: true, "DOVIInvalid|DOVIWithEL|DOVIWithELHDR10Plus|DOVI|DOVIWithHDR10|DOVIWithHDR10Plus");
+
+        Assert.NotNull(info);
+        Assert.Equal("ts", info.Container, StringComparer.OrdinalIgnoreCase);
+    }
+
+    [Fact]
+    public void MostCompatibleRetry_KeepsTs()
+    {
+        var info = Build(enabled: true, DoviCapableExcluded, mostCompatible: true);
+
+        Assert.NotNull(info);
+        Assert.Equal("ts", info.Container, StringComparer.OrdinalIgnoreCase);
+    }
+
+    [Fact]
+    public void DoviWithElHdr10PlusSource_NotConverted_KeepsTs()
+    {
+        var info = Build(enabled: true, DoviCapableExcluded, hdr10Plus: true);
+
+        Assert.NotNull(info);
+        Assert.Equal("ts", info.Container, StringComparer.OrdinalIgnoreCase);
+    }
+
+    [Fact]
+    public void NoVideoCopy_KeepsTs()
+    {
+        var info = Build(enabled: true, DoviCapableExcluded, allowVideoCopy: false);
+
+        Assert.NotNull(info);
+        Assert.Equal("ts", info.Container, StringComparer.OrdinalIgnoreCase);
+    }
+
+    private static StreamInfo? Build(bool enabled, string excludedRangeTypes, bool hdr10Plus = false, bool mostCompatible = false, bool allowVideoCopy = true, bool directPlay = true, bool noDefaultAudio = false, int? audioStreamIndex = null)
+    {
+        Environment.SetEnvironmentVariable("JELLYMESH_DOVI_P7_TO_81", enabled ? "1" : null);
+        try
+        {
+            var videoStream = new MediaStream
+            {
+                Type = MediaStreamType.Video,
+                Index = 0,
+                Codec = "hevc",
+                Profile = "Main 10",
+                Width = 3840,
+                Height = 2160,
+                BitDepth = 10,
+                BitRate = 40_000_000,
+                DvProfile = 7,
+                DvLevel = 6,
+                DvBlSignalCompatibilityId = 6,
+                RpuPresentFlag = 1,
+                BlPresentFlag = 1,
+                ElPresentFlag = 1,
+                ColorSpace = "bt2020nc",
+                ColorPrimaries = "bt2020",
+                ColorTransfer = "smpte2084",
+                Hdr10PlusPresentFlag = hdr10Plus ? true : null
+            };
+            Assert.Equal(hdr10Plus ? VideoRangeType.DOVIWithELHDR10Plus : VideoRangeType.DOVIWithEL, videoStream.VideoRangeType);
+
+            var mediaSource = new MediaSourceInfo
+            {
+                Id = "test-source",
+                Path = "/media/test.mkv",
+                Protocol = MediaProtocol.File,
+                Container = "mkv",
+                SupportsDirectPlay = true,
+                SupportsDirectStream = true,
+                SupportsTranscoding = true,
+                UseMostCompatibleTranscodingProfile = mostCompatible,
+                // "Play default audio track regardless of language" with no track flagged default:
+                // StreamBuilder then has no audio stream it may copy and transcodes it.
+                DefaultAudioIndexSource = noDefaultAudio ? AudioIndexSource.Default : AudioIndexSource.None,
+                MediaStreams =
+                [
+                    videoStream,
+                    new MediaStream { Type = MediaStreamType.Audio, Index = 1, Codec = "truehd", Profile = "Dolby TrueHD + Dolby Atmos", Channels = 8, SampleRate = 48000, BitDepth = 24, BitRate = 4_756_318, IsDefault = false },
+                    new MediaStream { Type = MediaStreamType.Audio, Index = 2, Codec = "ac3", Channels = 6, SampleRate = 48000, BitRate = 640_000 }
+                ]
+            };
+
+            const string AudioCodecs = "aac,ac3,alac,dca,dts,eac3,flac,mlp,mp2,mp3,opus,truehd,vorbis";
+            var profile = new DeviceProfile
+            {
+                Name = "Android TV app shape",
+                MaxStreamingBitrate = 120_000_000,
+                DirectPlayProfiles = directPlay
+                    ? [new DirectPlayProfile { Type = DlnaProfileType.Video, Container = "mkv,mp4", VideoCodec = "hevc,h264", AudioCodec = AudioCodecs }]
+                    : [],
+                CodecProfiles =
+                [
+                    new CodecProfile
+                    {
+                        Type = CodecType.Video,
+                        Codec = "hevc",
+                        Conditions = [new ProfileCondition(ProfileConditionType.NotEquals, ProfileConditionValue.VideoRangeType, excludedRangeTypes, false)],
+                        ApplyConditions = [new ProfileCondition(ProfileConditionType.EqualsAny, ProfileConditionValue.VideoRangeType, excludedRangeTypes, false)]
+                    }
+                ],
+                TranscodingProfiles =
+                [
+                    new TranscodingProfile
+                    {
+                        Type = DlnaProfileType.Video,
+                        Context = EncodingContext.Streaming,
+                        Protocol = MediaStreamProtocol.hls,
+                        Container = "ts",
+                        VideoCodec = "hevc,h264",
+                        AudioCodec = AudioCodecs,
+                        CopyTimestamps = false,
+                        EnableSubtitlesInManifest = true
+                    }
+                ]
+            };
+
+            var options = new MediaOptions
+            {
+                ItemId = new Guid("2B1C9C2E-6B90-4B7B-9C2E-8F6B90B4B7B9"),
+                MediaSourceId = mediaSource.Id,
+                MediaSources = [mediaSource],
+                DeviceId = "test-deviceId",
+                Profile = profile,
+                AllowAudioStreamCopy = true,
+                AllowVideoStreamCopy = allowVideoCopy,
+                EnableDirectPlay = true,
+                // MediaInfoHelper always turns Direct Stream off for PlaybackInfo.
+                EnableDirectStream = false,
+                AudioStreamIndex = audioStreamIndex
+            };
+
+            return new StreamBuilder(new Mock<ITranscoderSupport>().Object, new NullLogger<StreamBuilderDoviP7ToP81Fmp4Tests>())
+                .GetOptimalVideoStream(options);
+        }
+        finally
+        {
+            Environment.SetEnvironmentVariable("JELLYMESH_DOVI_P7_TO_81", null);
+        }
+    }
+}
