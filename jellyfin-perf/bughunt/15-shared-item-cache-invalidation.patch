@@ -0,0 +1,68 @@
+using System;
+using System.Collections.Generic;
+using Emby.Server.Implementations.Library;
+using Jellyfin.Database.Implementations;
+using Microsoft.EntityFrameworkCore;
+using Microsoft.Extensions.Logging.Abstractions;
+using Moq;
+using Xunit;
+
+namespace Jellyfin.Server.Implementations.Tests.Library;
+
+public class SharedItemInvalidationTests
+{
+    private static (SharedItemInvalidation Inv, List<Guid> Evicted) Create()
+    {
+        // The factory is never reached by Apply; the background poll just logs its failures.
+        var factory = new Mock<IDbContextFactory<JellyfinDbContext>>();
+        factory.Setup(f => f.CreateDbContext()).Throws(new InvalidOperationException("no database in unit tests"));
+        var evicted = new List<Guid>();
+        return (new SharedItemInvalidation(factory.Object, NullLogger.Instance, evicted.Add), evicted);
+    }
+
+    [Fact]
+    public void Apply_EvictsOtherNodesIds_SkipsOwn()
+    {
+        var (inv, evicted) = Create();
+        var now = DateTime.UtcNow;
+        var a = Guid.NewGuid();
+        var b = Guid.NewGuid();
+
+        var n = inv.Apply(
+            [(1, a, "othernode", now), (2, b, inv.Node, now)],
+            now.AddMinutes(-1));
+
+        Assert.Equal(1, n);
+        Assert.Equal([a], evicted);
+    }
+
+    [Fact]
+    public void Apply_OverlappingWindows_AppliesEachSeqOnce()
+    {
+        var (inv, evicted) = Create();
+        var now = DateTime.UtcNow;
+        var a = Guid.NewGuid();
+        var b = Guid.NewGuid();
+
+        inv.Apply([(5, a, "othernode", now)], now.AddMinutes(-1));
+        // Next poll re-reads seq 5 (overlap) and sees seq 4 that committed late (multi-writer autoinc order).
+        inv.Apply([(4, b, "othernode", now), (5, a, "othernode", now)], now.AddMinutes(-1));
+
+        Assert.Equal([a, b], evicted);
+        Assert.Equal(2, inv.Evicted);
+    }
+
+    [Fact]
+    public void Apply_ForgetsSeqsOlderThanHorizon()
+    {
+        var (inv, evicted) = Create();
+        var old = DateTime.UtcNow.AddMinutes(-5);
+        var a = Guid.NewGuid();
+
+        inv.Apply([(7, a, "othernode", old)], DateTime.UtcNow);
+        // Forgotten, so a re-read (which the time window no longer produces in practice) would apply again.
+        inv.Apply([(7, a, "othernode", old)], DateTime.UtcNow);
+
+        Assert.Equal([a, a], evicted);
+    }
+}
