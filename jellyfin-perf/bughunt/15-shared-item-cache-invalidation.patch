diff --git a/Emby.Server.Implementations/Library/SharedItemInvalidation.cs b/Emby.Server.Implementations/Library/SharedItemInvalidation.cs
new file mode 100644
index 000000000..0882737b0
--- /dev/null
+++ b/Emby.Server.Implementations/Library/SharedItemInvalidation.cs
@@ -0,0 +1,347 @@
+using System;
+using System.Collections.Generic;
+using System.Data;
+using System.Data.Common;
+using System.Globalization;
+using System.Linq;
+using System.Text;
+using System.Threading;
+using System.Threading.Tasks;
+using Jellyfin.Database.Implementations;
+using Jellyfin.Extensions;
+using Microsoft.EntityFrameworkCore;
+using Microsoft.Extensions.Logging;
+
+namespace Emby.Server.Implementations.Library
+{
+    /// <summary>
+    /// JELLYFIN_SHARED_DB=1: cross-node item-cache invalidation through the shared database itself
+    /// (no second store). A node that saves, re-images or deletes items appends their ids to a small
+    /// change table; every node polls it and evicts those ids from its item cache. The item cache's
+    /// short TTL stays as the safety net for anything written without going through here.
+    /// </summary>
+    /// <remarks>
+    /// Rows are read by time window (not by "Seq &gt; last"): on a multi-writer Galera cluster
+    /// auto-increment values are not committed in order, so a Seq watermark could skip a row that
+    /// commits late. The window overlaps the previous poll by <see cref="Overlap"/> and already-applied
+    /// Seqs are remembered, so every row is applied once. Timestamps come from the database clock
+    /// (UTC_TIMESTAMP), never the node's. MySQL/Galera only; any other provider disables it.
+    /// The poll holds one open connection for as long as it works (it runs every 250 ms on every node, so
+    /// checking one out of the pool per tick cost a pool reset + SET NAMES each time) and reads the clock
+    /// and the window in one round trip. A failed poll drops that connection; the next tick opens a new one.
+    /// Lives as long as the process (owned by the singleton LibraryManager), so it is not disposable.
+    /// </remarks>
+    public sealed class SharedItemInvalidation
+    {
+        /// <summary>Change table name.</summary>
+        public const string Table = "JellyMeshItemInvalidation";
+
+        private static readonly TimeSpan Overlap = TimeSpan.FromSeconds(3);
+        private static readonly TimeSpan Retention = TimeSpan.FromMinutes(10);
+
+        private readonly IDbContextFactory<JellyfinDbContext> _dbProvider;
+        private readonly ILogger _logger;
+        private readonly Action<Guid> _evict;
+        private readonly string _node = Guid.NewGuid().ToString("N", CultureInfo.InvariantCulture);
+        private readonly Dictionary<long, DateTime> _applied = new();
+        private readonly TimeSpan _interval;
+        private DateTime? _since;
+        private bool _ready;
+        private bool _disabled;
+        private long _lastCleanup;
+        private JellyfinDbContext? _pollContext;
+        private DbConnection? _pollConnection;
+
+        /// <summary>
+        /// Initializes a new instance of the <see cref="SharedItemInvalidation"/> class and starts polling.
+        /// </summary>
+        /// <param name="dbProvider">Database context factory.</param>
+        /// <param name="logger">Logger.</param>
+        /// <param name="evict">Removes one id from this node's item cache.</param>
+        public SharedItemInvalidation(IDbContextFactory<JellyfinDbContext> dbProvider, ILogger logger, Action<Guid> evict)
+        {
+            _dbProvider = dbProvider;
+            _logger = logger;
+            _evict = evict;
+            var ms = int.TryParse(Environment.GetEnvironmentVariable("JELLYFIN_SHARED_INVALIDATION_POLL_MS"), NumberStyles.Integer, CultureInfo.InvariantCulture, out var v) && v >= 50 ? v : 250;
+            _interval = TimeSpan.FromMilliseconds(ms);
+            _ = Task.Run(PollLoop);
+        }
+
+        /// <summary>Gets the number of ids this node evicted because another node changed them.</summary>
+        public long Evicted { get; private set; }
+
+        /// <summary>
+        /// Announces changed item ids to the other nodes. Never throws: on failure the TTL still bounds staleness.
+        /// </summary>
+        /// <param name="ids">Changed item ids.</param>
+        public void Publish(IEnumerable<Guid> ids)
+        {
+            if (_disabled)
+            {
+                return;
+            }
+
+            var list = ids.Where(i => !i.IsEmpty()).Distinct().ToList();
+            if (list.Count == 0)
+            {
+                return;
+            }
+
+            try
+            {
+                using var ctx = _dbProvider.CreateDbContext();
+                if (!EnsureTable(ctx))
+                {
+                    return;
+                }
+
+                var conn = ctx.Database.GetDbConnection();
+                conn.Open();
+                // Chunked multi-row insert: one replicated write-set per chunk, not per item.
+                foreach (var chunk in list.Chunk(500))
+                {
+                    using var cmd = conn.CreateCommand();
+                    var sql = new StringBuilder("INSERT INTO ").Append(Table).Append(" (ItemId, Node) VALUES ");
+                    for (var i = 0; i < chunk.Length; i++)
+                    {
+                        sql.Append(i == 0 ? string.Empty : ",").Append("(@i").Append(i).Append(",@n)");
+                        AddParam(cmd, "@i" + i.ToString(CultureInfo.InvariantCulture), chunk[i].ToString("N", CultureInfo.InvariantCulture));
+                    }
+
+                    AddParam(cmd, "@n", _node);
+                    cmd.CommandText = sql.ToString();
+                    cmd.ExecuteNonQuery();
+                }
+            }
+            catch (Exception ex)
+            {
+                _logger.LogWarning(ex, "Shared item invalidation: publishing {Count} ids failed; other nodes see the change within the cache TTL", list.Count);
+            }
+        }
+
+        /// <summary>
+        /// Applies rows read from the change table: evicts every id another node wrote that was not applied yet.
+        /// </summary>
+        /// <param name="rows">(Seq, ItemId, Node, At) rows.</param>
+        /// <param name="horizon">Rows older than this are forgotten (they can no longer be re-read).</param>
+        /// <returns>Number of ids evicted.</returns>
+        internal int Apply(IEnumerable<(long Seq, Guid ItemId, string Node, DateTime At)> rows, DateTime horizon)
+        {
+            var n = 0;
+            foreach (var (seq, itemId, node, at) in rows)
+            {
+                if (!_applied.TryAdd(seq, at))
+                {
+                    continue;
+                }
+
+                if (!string.Equals(node, _node, StringComparison.Ordinal))
+                {
+                    _evict(itemId);
+                    n++;
+                }
+            }
+
+            foreach (var old in _applied.Where(kv => kv.Value < horizon).Select(kv => kv.Key).ToList())
+            {
+                _applied.Remove(old);
+            }
+
+            Evicted += n;
+            return n;
+        }
+
+        /// <summary>Gets this node's id as written to the change table.</summary>
+        internal string Node => _node;
+
+        private static void AddParam(DbCommand cmd, string name, object value)
+        {
+            var p = cmd.CreateParameter();
+            p.ParameterName = name;
+            p.Value = value;
+            cmd.Parameters.Add(p);
+        }
+
+        private bool EnsureTable(JellyfinDbContext ctx)
+        {
+            if (_ready)
+            {
+                return true;
+            }
+
+            if (_disabled)
+            {
+                return false;
+            }
+
+            var provider = ctx.Database.ProviderName ?? string.Empty;
+            if (!provider.Contains("MySql", StringComparison.OrdinalIgnoreCase))
+            {
+                _disabled = true;
+                _logger.LogWarning("Shared item invalidation needs a MySQL/Galera database (provider {Provider}); relying on the item cache TTL only", provider);
+                return false;
+            }
+
+            ctx.Database.ExecuteSqlRaw(
+                "CREATE TABLE IF NOT EXISTS " + Table + " ("
+                + "Seq BIGINT NOT NULL AUTO_INCREMENT PRIMARY KEY, "
+                + "ItemId CHAR(32) NOT NULL, "
+                + "Node CHAR(32) NOT NULL, "
+                + "At DATETIME(6) NOT NULL DEFAULT (UTC_TIMESTAMP(6)), "
+                + "KEY IX_" + Table + "_At (At)) ENGINE=InnoDB");
+            _ready = true;
+            _logger.LogInformation("Shared item invalidation active: node {Node}, poll {Interval} ms", _node, _interval.TotalMilliseconds);
+            return true;
+        }
+
+        private async Task PollLoop()
+        {
+            using var timer = new PeriodicTimer(_interval);
+            var failures = 0;
+            try
+            {
+                while (await timer.WaitForNextTickAsync().ConfigureAwait(false))
+                {
+                    if (_disabled)
+                    {
+                        return;
+                    }
+
+                    try
+                    {
+                        Poll();
+                        failures = 0;
+                    }
+                    catch (Exception ex)
+                    {
+                        ClosePollConnection();
+                        // Startup (database not migrated yet) or a node failover: keep trying, log sparsely.
+                        if (failures++ % 40 == 0)
+                        {
+                            _logger.LogWarning(ex, "Shared item invalidation poll failed ({Failures}); item cache TTL still applies", failures);
+                        }
+                    }
+                }
+            }
+            catch (OperationCanceledException)
+            {
+            }
+            finally
+            {
+                ClosePollConnection();
+            }
+        }
+
+        private DbConnection? OpenPollConnection()
+        {
+            if (_pollConnection is { State: ConnectionState.Open })
+            {
+                return _pollConnection;
+            }
+
+            ClosePollConnection();
+            var ctx = _dbProvider.CreateDbContext();
+            try
+            {
+                if (!EnsureTable(ctx))
+                {
+                    ctx.Dispose();
+                    return null;
+                }
+
+                var conn = ctx.Database.GetDbConnection();
+                conn.Open();
+                _pollContext = ctx;
+                _pollConnection = conn;
+                return conn;
+            }
+            catch
+            {
+                ctx.Dispose();
+                throw;
+            }
+        }
+
+        private void ClosePollConnection()
+        {
+            var ctx = _pollContext;
+            _pollContext = null;
+            _pollConnection = null;
+            try
+            {
+                ctx?.Dispose();
+            }
+            catch (Exception ex)
+            {
+                _logger.LogDebug(ex, "Shared item invalidation: closing the poll connection failed");
+            }
+        }
+
+        private void Poll()
+        {
+            var conn = OpenPollConnection();
+            if (conn is null)
+            {
+                return;
+            }
+
+            // One round trip: the database clock, then the window since the last poll. The first poll has
+            // no previous clock reading; nothing before start-up matters (the cache was empty then), so its
+            // window starts at that same clock reading, minus the overlap.
+            DateTime now;
+            var rows = new List<(long, Guid, string, DateTime)>();
+            using (var cmd = conn.CreateCommand())
+            {
+                cmd.CommandText = "SELECT UTC_TIMESTAMP(6); SELECT Seq, ItemId, Node, At FROM " + Table + " WHERE At >= "
+                    + (_since.HasValue ? "@from" : "UTC_TIMESTAMP(6) - INTERVAL " + Overlap.TotalSeconds.ToString(CultureInfo.InvariantCulture) + " SECOND");
+                if (_since.HasValue)
+                {
+                    AddParam(cmd, "@from", _since.Value - Overlap);
+                }
+
+                using var reader = cmd.ExecuteReader();
+                if (!reader.Read())
+                {
+                    throw new InvalidOperationException("UTC_TIMESTAMP(6) returned no row");
+                }
+
+                now = Convert.ToDateTime(reader.GetValue(0), CultureInfo.InvariantCulture);
+                if (!reader.NextResult())
+                {
+                    throw new InvalidOperationException("Shared item invalidation window query returned no result set");
+                }
+
+                while (reader.Read())
+                {
+                    if (Guid.TryParse(reader.GetString(1), out var id))
+                    {
+                        rows.Add((reader.GetInt64(0), id, reader.GetString(2), reader.GetDateTime(3)));
+                    }
+                }
+            }
+
+            var since = _since ?? now;
+            Apply(rows, since - Overlap - Overlap);
+            _since = now;
+
+            var tick = Environment.TickCount64;
+            if (tick - _lastCleanup > 60_000)
+            {
+                _lastCleanup = tick;
+                try
+                {
+                    using var del = conn.CreateCommand();
+                    del.CommandText = "DELETE FROM " + Table + " WHERE At < @old LIMIT 10000";
+                    AddParam(del, "@old", now - Retention);
+                    del.ExecuteNonQuery();
+                }
+                catch (DbException ex)
+                {
+                    // Both nodes clean up; a certification conflict on the same rows is harmless.
+                    _logger.LogDebug(ex, "Shared item invalidation cleanup skipped");
+                }
+            }
+        }
+    }
+}
