diff --git a/tests/Jellyfin.Server.Implementations.Tests/SessionManager/SessionManagerPlaybackStoppedTests.cs b/tests/Jellyfin.Server.Implementations.Tests/SessionManager/SessionManagerPlaybackStoppedTests.cs
