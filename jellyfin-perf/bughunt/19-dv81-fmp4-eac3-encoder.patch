+    public void DoviP7ToP81Fmp4_TrueHdSource_ClientOffersEac3_EncodesEac3(string audioCodecs)
+    {
+        // MEASURED in tc-lab before this fix (12.1-jm8.3-lab-gh14): the Android TV list got
+        // libfdk_aac, "eac3,ac3" got ac3 -- CanEncodeToAudioCodec("eac3") was always false.
