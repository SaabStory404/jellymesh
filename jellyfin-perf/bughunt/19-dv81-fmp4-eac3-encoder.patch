+        Assert.Equal("eac3", state.BaseRequest.AudioCodec);
+        Assert.Equal("eac3", state.OutputAudioCodec);
+        Assert.Equal("eac3", helper.GetAudioEncoder(state));
+
+        // ffmpeg's eac3 encoder caps at 5.1; 640 kb/s for a >= 6-channel source.
+        Assert.Equal(6, state.OutputAudioChannels);
+        Assert.Equal(640000, state.OutputAudioBitrate);
+        Assert.True(state.TranscodeReasons.HasFlag(TranscodeReason.AudioCodecNotSupported));
+    }
