+    // JELLYMESH_DOVI_P7_TO_81, bughunt 19: TrueHD -> EAC3 for a DV7->8.1 fMP4 job ---------------
+
+    [Theory]
+    [InlineData(AndroidTvAudioCodecs)] // the client's own order: aac before eac3
+    [InlineData("eac3,aac,ac3,alac,dts,flac,mp3,opus")] // the URL bughunt 18's StreamBuilder sends (eac3 first)
+    [InlineData("eac3,ac3")]
