+        /// <summary>
+        /// JELLYMESH_DOVI_P7_TO_81 (bughunt 19): whether this job should encode its audio to EAC3.
+        /// True for an HLS job with fMP4 segments that converts Dolby Vision profile 7 to 8.1
+        /// (<see cref="IsDoviP7ToP81Converted"/>), whose audio stream is TrueHD/MLP with at least
+        /// 6 channels, when the client lists <c>eac3</c> and ffmpeg has the <c>eac3</c> encoder.
+        ///
+        /// bughunt 18 dropped truehd/mlp from this job's candidate list (media3 cannot demux TrueHD
+        /// from fMP4) and moved eac3 to the front of it, but the output codec is picked here, as the
+        /// first candidate <c>CanEncodeToAudioCodec</c> accepts -- and that was
+        /// always false for eac3, because upstream's encoder whitelist
+        /// (EncoderValidator._requiredEncoders) never listed it. So eac3 was skipped whenever any
+        /// other candidate was offered (MEASURED in tc-lab: the Android TV list got AAC 5.1,
+        /// <c>eac3,ac3</c> got AC3, <c>eac3</c> alone got EAC3 only via the fall-back to the first
+        /// entry). The whitelist now detects eac3, and this is the only place that asks for it
+        /// (CanEncodeToAudioCodec still answers false for eac3, so every other job is unchanged).
+        /// The copy decision is untouched: it tests the candidate list, not this pick, so a
+        /// copyable AC3/EAC3 source is still copied. Sources below 6 channels keep upstream's
+        /// rule (ShiftAudioCodecsIfNeeded: a 2-channel ac3/eac3 transcode is avoided).
+        /// </summary>
+        /// <param name="state">The encoding job.</param>
+        /// <returns>Whether the audio transcode target is EAC3.</returns>
+        public bool PrefersEac3ForDoviP7ToP81Fmp4(EncodingJobInfo state)
+        {
+            var audioStream = state?.AudioStream;
+            return DoviP7ToP81Enabled
+                && audioStream is not null
+                && state.BaseRequest is StreamingRequestDto { SegmentContainer: var segmentContainer }
+                && string.Equals(segmentContainer, "mp4", StringComparison.OrdinalIgnoreCase)
+                && (string.Equals(audioStream.Codec, "truehd", StringComparison.OrdinalIgnoreCase)
+                    || string.Equals(audioStream.Codec, "mlp", StringComparison.OrdinalIgnoreCase))
+                && (audioStream.Channels ?? 6) >= 6
+                && state.SupportedAudioCodecs.Contains("eac3", StringComparison.OrdinalIgnoreCase)
+                && _mediaEncoder.SupportsEncoder("eac3")
+                && IsDoviP7ToP81Converted(state);
+        }
