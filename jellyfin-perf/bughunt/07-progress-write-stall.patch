+    [Fact]
+    public void SaveUserData_Finished_RealConflict_WrappedInInvalidOperationException_RetriesAndSucceeds()
+    {
+        var item = CreateAudioBook();
+        SeedUserAndItem(item);
+        var userData = new UserItemData { Key = item.GetUserDataKeys()[0], PlaybackPositionTicks = 666, Played = true };
+
+        // The exact shape this file's own comment on IsWriteConflict describes: a provider without a
+        // retrying execution strategy configured wraps the already-EF-wrapped DbUpdateException in a
+        // further InvalidOperationException, so the real conflict sits two InnerException hops down --
+        // InvalidOperationException -> DbUpdateException -> the provider's own DbException -- not one.
+        // DbUpdateException does not itself derive from DbException, so a fixed-depth unwrap that only
+        // checks "InvalidOperationException.InnerException as DbException" lands on null here and
+        // wrongly treats a real wsrep/deadlock conflict as non-retryable.
+        var interceptor = new ThrowNTimesInterceptor(
+            1,
+            () => new InvalidOperationException(
+                "An exception has been raised that is likely due to a transient failure. Consider enabling transient error resiliency.",
+                new DbUpdateException(
+                    "An error occurred while saving the entity changes.",
+                    new FakeDbException("Deadlock found when trying to get lock; try restarting transaction (WSREP detected deadlock)", "40001"))));
+        var manager = CreateManagerWithInterceptor(interceptor);
+
+        // Must still retry and land the write -- dropping this would drop a Finished report on a real
+        // Galera certification failure delivered via this exact wrapper shape.
+        manager.SaveUserData(_user, item, userData, UserDataSaveReason.PlaybackFinished, CancellationToken.None);
+
+        Assert.Equal(2, interceptor.Invocations);
+        using var ctx = CreateDbContext();
+        var rows = ctx.UserData.Where(e => e.ItemId.Equals(item.Id)).ToList();
+        Assert.NotEmpty(rows);
+        Assert.All(rows, row => Assert.Equal(666, row.PlaybackPositionTicks));
+    }
