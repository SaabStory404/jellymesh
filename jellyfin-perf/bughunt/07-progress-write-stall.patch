+    /// <summary>A <see cref="DbException"/> whose <see cref="SqlState"/> a test controls directly, standing in for a real provider's (e.g. MySqlConnector's) exception without depending on that provider.</summary>
+    private sealed class FakeDbException : DbException
+    {
+        public FakeDbException(string message, string? sqlState)
+            : base(message)
+        {
+            SqlState = sqlState;
+        }
+
+        public override string? SqlState { get; }
+    }
+
+    /// <summary>Throws a fresh exception (from <paramref name="exception"/>) from the first <paramref name="throwCount"/> SaveChanges/SaveChangesAsync calls, then lets subsequent calls proceed normally.</summary>
+    private sealed class ThrowNTimesInterceptor : SaveChangesInterceptor
+    {
+        private readonly int _throwCount;
+        private readonly Func<Exception> _exception;
+        private int _invocations;
+
+        public ThrowNTimesInterceptor(int throwCount, Func<Exception> exception)
+        {
+            _throwCount = throwCount;
+            _exception = exception;
+        }
+
+        public int Invocations => _invocations;
+
+        public override InterceptionResult<int> SavingChanges(DbContextEventData eventData, InterceptionResult<int> result)
+        {
+            var attempt = Interlocked.Increment(ref _invocations);
+            if (attempt <= _throwCount)
+            {
+                throw _exception();
+            }
+
+            return result;
+        }
+
+        public override ValueTask<InterceptionResult<int>> SavingChangesAsync(DbContextEventData eventData, InterceptionResult<int> result, CancellationToken cancellationToken = default)
+        {
+            var attempt = Interlocked.Increment(ref _invocations);
+            if (attempt <= _throwCount)
+            {
+                throw _exception();
+            }
+
+            return ValueTask.FromResult(result);
+        }
+    }
+
+    /// <summary>
+    /// Simulates a write stuck on the database (e.g. a Galera commit blocked behind flow control):
+    /// SaveChanges/SaveChangesAsync never complete on their own. The async side honors the caller's
+    /// CancellationToken exactly like a real provider would; the sync side is unstuck only by
+    /// disposing this interceptor, since production's own sync call site has no token to cancel it
+    /// with either -- that gap is the point of the test that uses it.
+    /// </summary>
+    private sealed class HangingInterceptor : SaveChangesInterceptor, IDisposable
+    {
+        private readonly CancellationTokenSource _teardown = new();
+
+        public override InterceptionResult<int> SavingChanges(DbContextEventData eventData, InterceptionResult<int> result)
+        {
+            Task.Delay(Timeout.InfiniteTimeSpan, _teardown.Token).GetAwaiter().GetResult();
+            return result;
+        }
+
+        public override async ValueTask<InterceptionResult<int>> SavingChangesAsync(DbContextEventData eventData, InterceptionResult<int> result, CancellationToken cancellationToken = default)
+        {
+            await Task.Delay(Timeout.InfiniteTimeSpan, cancellationToken).ConfigureAwait(false);
+            return result;
+        }
+
+        public void Dispose() => _teardown.Cancel();
+    }
