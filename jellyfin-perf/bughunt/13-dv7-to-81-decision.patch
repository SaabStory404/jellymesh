+using System;
+using System.Collections.Generic;
+using Jellyfin.Data.Enums;
+using MediaBrowser.Model.Dlna;
+using MediaBrowser.Model.Dto;
+using MediaBrowser.Model.Entities;
+using MediaBrowser.Model.MediaInfo;
+using MediaBrowser.Model.Session;
+using Microsoft.Extensions.Logging.Abstractions;
+using Moq;
+using Xunit;
+
+namespace Jellyfin.Model.Tests.Dlna;
+
+/// <summary>
+/// JELLYMESH_DOVI_P7_TO_81: a Dolby Vision profile 7 (dual-layer EL) source, checked against a
+/// CodecProfile's VideoRangeType condition, must be treated as satisfying "DOVI" / "DOVIWithHDR10"
+/// (not just "DOVIWithEL") when the feature is enabled -- because EncodingHelper will actually
+/// deliver it as a converted profile 8.1 stream, not the untouched profile 7 one. This is
+/// observable through StreamBuilder.GetOptimalVideoStream only via which of two competing
+/// hevc-capable TranscodingProfiles wins the ranking in GetVideoTranscodeProfile (the profile
+/// with a matching CodecProfile condition ranks better than the fallback, unconstrained one) --
+/// see EncodingHelperDoviTests for the direct, ffmpeg-command-line-facing assertions. The
+/// substitution is decided per-condition, not once for the whole CodecProfile: a condition that
+/// already declares DOVIWithEL support in its own value list (second-review fix) keeps evaluating
+/// against the source's real, unconverted range type and must keep winning on that literal match
+/// alone, exactly like bh-base -- see GetOptimalVideoStream_ElDeclaringCodecProfile_Enabled_ConstrainedProfileStillWins.
+/// </summary>
+public class StreamBuilderDoviP7ToP81Tests
+{
+    [Fact]
+    public void GetOptimalVideoStream_DoviCapableProfile_Disabled_PrefersUnconstrainedFallback()
+    {
+        var streamInfo = BuildFor(doviCapable: true, enabled: false);
+
+        Assert.NotNull(streamInfo);
+        Assert.Equal(PlayMethod.Transcode, streamInfo.PlayMethod);
+
+        // bh-base: a profile-7 (DOVIWithEL) source fails the DOVI/DOVIWithHDR10 CodecProfile
+        // condition (it only satisfies literal "DOVIWithEL", which this device profile does not
+        // declare), so the constrained "mp4" TranscodingProfile ranks WORSE than the
+        // unconstrained "ts" fallback (rank.Video==2 vs 1: this is "ts" strictly outranking it,
+        // not an array-order tie-break like the "Enabled" case below).
+        Assert.Equal("ts", streamInfo.Container, StringComparer.OrdinalIgnoreCase);
+    }
+
+    [Fact]
+    public void GetOptimalVideoStream_DoviCapableProfile_Enabled_PrefersDoviConstrainedProfile()
+    {
+        var streamInfo = BuildFor(doviCapable: true, enabled: true);
+
+        Assert.NotNull(streamInfo);
+        Assert.Equal(PlayMethod.Transcode, streamInfo.PlayMethod);
+
+        // JELLYMESH_DOVI_P7_TO_81=1: the profile-7 source now satisfies the DOVI/DOVIWithHDR10
+        // condition too, so the "mp4" TranscodingProfile ties the fallback's video rank and wins
+        // on array order -- proving the P7 source passed this DOVI-capable profile's range
+        // condition instead of falling through to the unconstrained fallback.
+        Assert.Equal("mp4", streamInfo.Container, StringComparer.OrdinalIgnoreCase);
+    }
+
+    [Fact]
+    public void GetOptimalVideoStream_Hdr10OnlyProfile_Enabled_StillPrefersUnconstrainedFallback()
+    {
+        // A device that only ever declares HDR10 (never DOVI/DOVIWithHDR10) must not be affected
+        // by this feature at all: the substitution only ever maps DOVIWithEL to DOVIWithHDR10, so
+        // a condition that never lists either still fails, exactly as it does with the feature off.
+        var streamInfo = BuildFor(doviCapable: false, enabled: true);
+
+        Assert.NotNull(streamInfo);
+        Assert.Equal("ts", streamInfo.Container, StringComparer.OrdinalIgnoreCase);
+    }
+
+    [Fact]
+    public void GetOptimalVideoStream_DoviCapableProfile_Enabled_DoviWithElHdr10Plus_NotSubstituted()
+    {
+        // EncodingHelper never converts DOVIWithELHDR10Plus (scoped out -- see
+        // ShouldRemoveDynamicHdrMetadata's ConvertDoviP7ToP81 comment), so StreamBuilder must not
+        // substitute it either: ranking the constrained "mp4" profile as video-copy-eligible here
+        // would pick a different TranscodingProfile/container than bh-base for a source that
+        // EncodingHelper still strips to HDR10 server-side regardless. Fallback must keep winning.
+        var streamInfo = BuildFor(doviCapable: true, enabled: true, hdr10Plus: true);
+
+        Assert.NotNull(streamInfo);
+        Assert.Equal("ts", streamInfo.Container, StringComparer.OrdinalIgnoreCase);
+    }
+
+    [Fact]
+    public void GetOptimalVideoStream_DoviCapableProfile_Enabled_HttpProtocolCandidateNeverWins()
+    {
+        // Regression for the Protocol-blind substitution bug: an http/Progressive-protocol
+        // TranscodingProfile ("avi") constrained by the SAME DOVI/DOVIWithHDR10 CodecProfile
+        // condition as the hls "mp4" one must never win this ranking on the strength of the
+        // substitution -- EncodingHelper's real P7->8.1 conversion is gated on
+        // TranscodingJobType.Hls and the pool marker is wired only into DynamicHlsController, so
+        // an http-protocol pick here would route this client to Progressive delivery
+        // (VideosController/GetProgressiveVideoArguments) of a source EncodingHelper still
+        // strips/copies raw there, silently reintroducing the Progressive-exclusion gap.
+        // "avi" is listed FIRST in TranscodingProfiles (see BuildFor) so that, without the
+        // Protocol gate, it would tie "mp4" at rank.Video==1/rank.Audio==1 and win outright via
+        // stable-sort array order -- this proves the exclusion, not a coincidence of ordering.
+        var streamInfo = BuildFor(doviCapable: true, enabled: true, includeHttpProtocolCandidate: true);
+
+        Assert.NotNull(streamInfo);
+        Assert.Equal(PlayMethod.Transcode, streamInfo.PlayMethod);
+        Assert.NotEqual("avi", streamInfo.Container, StringComparer.OrdinalIgnoreCase);
+        Assert.NotEqual(MediaStreamProtocol.http, streamInfo.SubProtocol);
+
+        // The hls "mp4" profile is still the correct pick, exactly as in
+        // GetOptimalVideoStream_DoviCapableProfile_Enabled_PrefersDoviConstrainedProfile above.
+        Assert.Equal("mp4", streamInfo.Container, StringComparer.OrdinalIgnoreCase);
+        Assert.Equal(MediaStreamProtocol.hls, streamInfo.SubProtocol);
+    }
+
+    [Fact]
+    public void GetOptimalVideoStream_ElDeclaringCodecProfile_Enabled_ConstrainedProfileStillWins()
+    {
+        // Second-review regression: a CodecProfile condition whose OWN VideoRangeType value list
+        // already names "DOVIWithEL" literally (e.g. a hand-written Kodi/DLNA-style profile, as
+        // opposed to jellyfin-web which always bundles DOVIWithEL alongside DOVI/DOVIWithHDR10 in
+        // one list) must keep passing on that literal match even with the flag on. Substituting
+        // DOVIWithEL -> DOVIWithHDR10 before checking THIS condition would turn an
+        // already-satisfied condition into a failing one, because the substituted value is not in
+        // this profile's list -- that is the bug the second review found (StreamBuilder's
+        // substitution was applied per-array, not per-condition, so it never checked whether the
+        // very condition being evaluated already covered DOVIWithEL). Mirrors EncodingHelper's own
+        // "!requestHasDOVIwithEL" gate: a client that already declares DOVIWithEL support gets
+        // untouched passthrough server-side, unaffected by the flag, so the client-decision side
+        // must keep picking the same profile bh-base does.
+        var flagOff = BuildFor(doviCapable: true, enabled: false, conditionRangeTypeValues: "SDR|HDR10|HLG|DOVIWithEL");
+        var flagOn = BuildFor(doviCapable: true, enabled: true, conditionRangeTypeValues: "SDR|HDR10|HLG|DOVIWithEL");
+
+        Assert.NotNull(flagOff);
+        Assert.NotNull(flagOn);
+        Assert.Equal(PlayMethod.Transcode, flagOff.PlayMethod);
+        Assert.Equal(PlayMethod.Transcode, flagOn.PlayMethod);
+
+        // Same winner with the flag on as with it off: the source's real, unconverted DOVIWithEL
+        // range type satisfies this condition on its own literal merits (not via the
+        // substitution), ties the "ts" fallback's rank, and wins on array order -- exactly like
+        // Enabled_PrefersDoviConstrainedProfile above, just via the real value instead of the
+        // substituted one.
+        Assert.Equal("mp4", flagOff.Container, StringComparer.OrdinalIgnoreCase);
+        Assert.Equal("mp4", flagOn.Container, StringComparer.OrdinalIgnoreCase);
+        Assert.Equal(MediaStreamProtocol.hls, flagOn.SubProtocol);
+    }
+
+    private static StreamInfo? BuildFor(bool doviCapable, bool enabled, bool hdr10Plus = false, bool includeHttpProtocolCandidate = false, string? conditionRangeTypeValues = null)
+    {
+        Environment.SetEnvironmentVariable("JELLYMESH_DOVI_P7_TO_81", enabled ? "1" : null);
+        try
+        {
+            var videoStream = new MediaStream
+            {
+                Type = MediaStreamType.Video,
+                Index = 0,
+                Codec = "hevc",
+                Width = 1920,
+                Height = 1080,
+                BitDepth = 10,
+                DvProfile = 7,
+                DvBlSignalCompatibilityId = 6,
+                RpuPresentFlag = 1,
+                BlPresentFlag = 1,
+                ColorSpace = "bt2020nc",
+                ColorPrimaries = "bt2020",
+                ColorTransfer = "smpte2084",
+                Hdr10PlusPresentFlag = hdr10Plus ? true : null
+            };
+            Assert.Equal(hdr10Plus ? VideoRangeType.DOVIWithELHDR10Plus : VideoRangeType.DOVIWithEL, videoStream.VideoRangeType);
+
+            var mediaSource = new MediaSourceInfo
+            {
+                Id = "test-source",
+                Path = "/media/test.mkv",
+                Protocol = MediaProtocol.File,
+                Container = "mkv",
+                SupportsDirectPlay = false,
+                SupportsDirectStream = true,
+                SupportsTranscoding = true,
+                MediaStreams =
+                [
+                    videoStream,
+                    new MediaStream { Type = MediaStreamType.Audio, Index = 1, Codec = "aac", Channels = 2 }
+                ]
+            };
+
+            var rangeTypeValues = conditionRangeTypeValues ?? (doviCapable ? "SDR|HDR10|HLG|DOVI|DOVIWithHDR10" : "SDR|HDR10|HLG");
+
+            var codecProfiles = new List<CodecProfile>
+            {
+                new()
+                {
+                    Type = CodecType.Video,
+                    Codec = "hevc",
+                    Container = "mp4",
+                    Conditions = [new ProfileCondition(ProfileConditionType.EqualsAny, ProfileConditionValue.VideoRangeType, rangeTypeValues, false)]
+                }
+            };
+
+            var transcodingProfiles = new List<TranscodingProfile>();
+            if (includeHttpProtocolCandidate)
+            {
+                // An http/Progressive-protocol twin of the "mp4" profile below, gated by its OWN
+                // CodecProfile entry (container "avi") carrying the identical DOVI/DOVIWithHDR10
+                // condition -- CodecProfile.ContainsAnyCodec matches on container, so "avi" needs
+                // its own entry to be "constrained" at all; it does not inherit "mp4"'s. Added
+                // FIRST so a pre-fix (Protocol-blind) tie against "mp4" would be won by THIS one
+                // via stable-sort array order -- see
+                // GetOptimalVideoStream_DoviCapableProfile_Enabled_HttpProtocolCandidateNeverWins.
+                codecProfiles.Add(new CodecProfile
+                {
+                    Type = CodecType.Video,
+                    Codec = "hevc",
+                    Container = "avi",
+                    Conditions = [new ProfileCondition(ProfileConditionType.EqualsAny, ProfileConditionValue.VideoRangeType, rangeTypeValues, false)]
+                });
+                transcodingProfiles.Add(new TranscodingProfile
+                {
+                    Type = DlnaProfileType.Video,
+                    Context = EncodingContext.Streaming,
+                    Protocol = MediaStreamProtocol.http,
+                    Container = "avi",
+                    VideoCodec = "hevc",
+                    AudioCodec = "aac"
+                });
+            }
+
+            // Constrained: only ranks video-copy-eligible (rank.Video==1) when videoStream
+            // satisfies the CodecProfile above.
+            transcodingProfiles.Add(new TranscodingProfile
+            {
+                Type = DlnaProfileType.Video,
+                Context = EncodingContext.Streaming,
+                Protocol = MediaStreamProtocol.hls,
+                Container = "mp4",
+                VideoCodec = "hevc",
+                AudioCodec = "aac"
+            });
+
+            // Unconstrained fallback for the same codec: no CodecProfile targets "ts", so
+            // GetCompatibilityVideoCodec always returns 0 failures here (rank.Video==1
+            // unconditionally) -- this is what the "mp4" profile above must tie (and beat on array
+            // order) once the DOVIWithEL source is treated as DOVI-capable.
+            transcodingProfiles.Add(new TranscodingProfile
+            {
+                Type = DlnaProfileType.Video,
+                Context = EncodingContext.Streaming,
+                Protocol = MediaStreamProtocol.hls,
+                Container = "ts",
+                VideoCodec = "hevc",
+                AudioCodec = "aac"
+            });
+
+            var profile = new DeviceProfile
+            {
+                Name = "DoviP7ToP81 test client",
+                // No DirectPlayProfiles: forces GetVideoDirectPlayProfile to fail so BuildVideoItem
+                // falls through to GetVideoTranscodeProfile, the path this feature touches.
+                DirectPlayProfiles = [],
+                CodecProfiles = codecProfiles.ToArray(),
+                TranscodingProfiles = transcodingProfiles.ToArray()
+            };
+
+            var options = new MediaOptions
+            {
+                ItemId = new Guid("2B1C9C2E-6B90-4B7B-9C2E-8F6B90B4B7B9"),
+                MediaSourceId = mediaSource.Id,
+                MediaSources = [mediaSource],
+                DeviceId = "test-deviceId",
+                Profile = profile,
+                AllowAudioStreamCopy = true,
+                AllowVideoStreamCopy = true,
+                EnableDirectStream = false
+            };
+
+            var transcodeSupport = new Mock<ITranscoderSupport>();
+
+            return new StreamBuilder(transcodeSupport.Object, new NullLogger<StreamBuilderDoviP7ToP81Tests>())
+                .GetOptimalVideoStream(options);
+        }
+        finally
+        {
+            Environment.SetEnvironmentVariable("JELLYMESH_DOVI_P7_TO_81", null);
+        }
+    }
+}
