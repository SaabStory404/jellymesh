+    // HLS copy-video remux restart: EncodingHelper.GetFastSeekCommandLineParameter adds a
+    // defensive 0.5s (5,000,000-tick) nudge to -ss so ffmpeg's keyframe-snapped seek for the
+    // copied video stream lands on the intended keyframe rather than rounding down to the
+    // previous one. Left at ffmpeg's default, accurate seek then honors that nudged -ss
+    // literally for the (usually transcoded) audio stream too, producing a real A/V start-time
+    // offset. -noaccurate_seek must be added alongside the existing nudge in that same
+    // isHlsRemuxing branch only -- fully transcoded video and non-HLS remuxing must keep their
+    // exact pre-existing -ss value and must not gain -noaccurate_seek.
+    [Fact]
+    public void GetFastSeekCommandLineParameter_HlsCopyVideoRemux_NudgesSeekAndAddsNoAccurateSeek()
+    {
+        var state = BuildSeekState(TranscodingJobType.Hls, outputVideoCodec: "copy", SeekStartTicks);
+        var result = CreateSeekHelper().GetFastSeekCommandLineParameter(state, new EncodingOptions(), "mp4");
+
+        Assert.Equal(
+            "-ss " + (SeekStartTicks + SeekNudgeTicks).ToString(CultureInfo.InvariantCulture) + " -noaccurate_seek",
+            result,
+            StringComparer.Ordinal);
+    }
+
