                 seekParam += string.Format(CultureInfo.InvariantCulture, "-ss {0}", _mediaEncoder.GetTimeParameter(seekTick));
+
+                if (isHlsRemuxing)
+                {
+                    // The copied video stream can only ever start at the keyframe at-or-before
+                    // the seek target (the 0.5s nudge above exists to make ffmpeg reliably land
+                    // on that keyframe rather than rounding down to the previous one). Left at
+                    // its default, accurate seek then decodes-and-discards the audio stream -
+                    // which for this remux case is usually being transcoded (e.g. DTS/TrueHD to
+                    // AAC) - all the way to the nudged -ss value, so audio starts up to ~0.5s
+                    // after the copied video's keyframe. When the caller's requested time isn't
+                    // itself keyframe-aligned the gap is worse: video is still pinned to the
+                    // keyframe at-or-before the request, but accurate-seeked audio starts at the
+                    // literal (later, and for a copy stream unreachable) request time, so the
+                    // gap grows to the full keyframe-interval distance.
+                    // Disabling accurate seek makes the (typically transcoded) audio track seek
+                    // at the same demuxer/packet level as the copied video track, so both land
+                    // together near the same keyframe instead of audio drifting to a target video
+                    // can't reach. Measured on a synthetic long-GOP source: collapses a ~0.46s
+                    // keyframe-aligned gap and a ~7.8s unaligned-seek gap to the same ~0.12s
+                    // (bounded by audio frame granularity, not by how far into the GOP the
+                    // original request fell). This does not affect fully transcoded video or
+                    // non-HLS output, since isHlsRemuxing is false for both.
+                    seekParam += " -noaccurate_seek";
+                }
             }
 
             return seekParam;
