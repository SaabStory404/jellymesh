+        /// <summary>
+        /// Among candidates that already satisfy the playback mode's own eligibility predicate (e.g. the
+        /// Default mode's external/default/forced check), prefers a text-based subtitle over an
+        /// image-based one (e.g. PGS/VobSub) when it shares the same language and forced flag as the
+        /// initially selected stream. This avoids forcing a burn-in transcode when a same-language text
+        /// alternative to a disposition-flagged image subtitle exists, without letting a
+        /// different-language, differently-forced, or otherwise-ineligible text track outrank the
+        /// selection the mode's own rules already produced. When the selected image track is a full
+        /// (non-forced) track, a text track that looks like a partial signs/songs, forced or commentary
+        /// track by title is never a swap candidate, even when its forced flag is unset: it is not a
+        /// substitute for a full same-language default. A forced image track can still be swapped for a
+        /// same-language forced text track.
+        /// </summary>
+        private static MediaStream? PreferSameLanguageTextSubtitle(MediaStream? candidate, IEnumerable<MediaStream> sortedStreams, Func<MediaStream, bool> eligiblePredicate)
+        {
+            if (candidate is null || candidate.IsTextSubtitleStream)
+            {
+                return candidate;
+            }
+
+            return sortedStreams.FirstOrDefault(x =>
+                eligiblePredicate(x)
+                && x.IsTextSubtitleStream
+                && x.IsForced == candidate.IsForced
+                && (candidate.IsForced || !IsPartialTextSubtitleByTitle(x))
+                && string.Equals(x.Language, candidate.Language, StringComparison.OrdinalIgnoreCase))
+                ?? candidate;
+        }
+
+        // Titles containing these (case-insensitive) typically indicate a partial text track -
+        // signs/songs-only, forced-only, or a commentary track - rather than a full same-language
+        // subtitle track, so such a track must never be swapped in for a full disposition-flagged
+        // default even when its own IsForced flag is unset.
+        private static readonly string[] _partialTextSubtitleTitleKeywords = { "sign", "song", "commentary", "forced" };
+
+        private static bool IsPartialTextSubtitleByTitle(MediaStream stream)
+        {
+            var title = stream.Title;
+            if (string.IsNullOrEmpty(title))
+            {
+                return false;
+            }
+
+            foreach (var keyword in _partialTextSubtitleTitleKeywords)
+            {
+                if (title.Contains(keyword, StringComparison.OrdinalIgnoreCase))
+                {
+                    return true;
+                }
+            }
+
+            return false;
+        }
