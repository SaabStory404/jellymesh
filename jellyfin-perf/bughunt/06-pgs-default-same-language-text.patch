+            Subtitle(1, "subrip", "eng", isDefault: true)
+        };
+
+        var result = MediaStreamSelector.GetDefaultSubtitleStreamIndex(streams, Array.Empty<string>(), SubtitlePlaybackMode.Default, "eng");
+
+        Assert.Equal(1, result);
+    }
