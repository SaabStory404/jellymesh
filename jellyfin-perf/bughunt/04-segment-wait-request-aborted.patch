@@ -0,0 +1,257 @@
+using System;
+using System.Diagnostics;
+using System.IO;
+using System.Threading;
+using System.Threading.Tasks;
+using Jellyfin.Api.Controllers;
+using Jellyfin.Api.Helpers;
+using Jellyfin.MediaEncoding.Hls.Playlist;
+using MediaBrowser.Controller.Configuration;
+using MediaBrowser.Controller.Library;
+using MediaBrowser.Controller.MediaEncoding;
+using MediaBrowser.Controller.Streaming;
+using MediaBrowser.Model.Configuration;
+using MediaBrowser.Model.IO;
+using Microsoft.AspNetCore.Http;
+using Microsoft.AspNetCore.Mvc;
+using Microsoft.Extensions.Logging.Abstractions;
+using Moq;
+using Xunit;
+
+namespace Jellyfin.Api.Tests.Controllers
+{
+    public class DynamicHlsControllerSegmentWaitTests
+    {
+        // Builds a real DynamicHlsController (not a test double) so GetSegmentResult below drives
+        // the actual production wait loop and abort-handling logic, not a reimplementation of it.
+        // Every dependency besides ITranscodeManager is unused by GetSegmentResult's code path and
+        // is stubbed out minimally.
+        private static DynamicHlsController CreateController(Mock<ITranscodeManager> transcodeManager, CancellationToken requestAborted)
+        {
+            var serverConfigurationManager = new Mock<IServerConfigurationManager>();
+            serverConfigurationManager.Setup(s => s.GetConfiguration("encoding"))
+                .Returns(new EncodingOptions());
+
+            var controller = new DynamicHlsController(
+                Mock.Of<ILibraryManager>(),
+                Mock.Of<IUserManager>(),
+                Mock.Of<IMediaSourceManager>(),
+                serverConfigurationManager.Object,
+                Mock.Of<IMediaEncoder>(),
+                Mock.Of<IFileSystem>(),
+                transcodeManager.Object,
+                NullLogger<DynamicHlsController>.Instance,
+                null!,
+                null!,
+                Mock.Of<IDynamicHlsPlaylistGenerator>());
+
+            controller.ControllerContext = new ControllerContext
+            {
+                HttpContext = new DefaultHttpContext { RequestAborted = requestAborted }
+            };
+
+            return controller;
+        }
+
+        [Theory]
+        [MemberData(nameof(GetSegmentLengths_Success_TestData))]
+        public void GetSegmentLengths_Success(long runtimeTicks, int segmentlength, double[] expected)
+        {
+            var res = DynamicHlsController.GetSegmentLengthsInternal(runtimeTicks, segmentlength);
+            Assert.Equal(expected.Length, res.Length);
+            for (int i = 0; i < expected.Length; i++)
+            {
+                Assert.Equal(expected[i], res[i]);
+            }
+        }
+
+        public static TheoryData<long, int, double[]> GetSegmentLengths_Success_TestData()
+        {
+            var data = new TheoryData<long, int, double[]>();
+            data.Add(0, 6, Array.Empty<double>());
+            data.Add(
+                TimeSpan.FromSeconds(3).Ticks,
+                6,
+                new double[] { 3 });
+            data.Add(
+                TimeSpan.FromSeconds(6).Ticks,
+                6,
+                new double[] { 6 });
+            data.Add(
+                TimeSpan.FromSeconds(3.3333333).Ticks,
+                6,
+                new double[] { 3.3333333 });
+            data.Add(
+                TimeSpan.FromSeconds(9.3333333).Ticks,
+                6,
+                new double[] { 6, 3.3333333 });
+
+            return data;
+        }
+
+        [Fact]
+        public async Task WaitForActiveTranscodingRequests_WaitsUntilRequestCompletes()
+        {
+            var job = new TranscodingJob(NullLogger<TranscodingJob>.Instance)
+            {
+                ActiveRequestCount = 1
+            };
+
+            var waitTask = DynamicHlsController.WaitForActiveTranscodingRequests(job, CancellationToken.None);
+            Assert.False(waitTask.IsCompleted);
+
+            job.DecrementActiveRequestCount();
+
+            await waitTask;
+        }
+
+        [Fact]
+        public async Task WaitForActiveTranscodingRequests_WaitsForEveryRequest()
+        {
+            var job = new TranscodingJob(NullLogger<TranscodingJob>.Instance)
+            {
+                ActiveRequestCount = 2
+            };
+
+            var waitTask = DynamicHlsController.WaitForActiveTranscodingRequests(job, CancellationToken.None);
+            job.DecrementActiveRequestCount();
+
+            await Task.Delay(150, TestContext.Current.CancellationToken);
+            Assert.False(waitTask.IsCompleted);
+
+            job.DecrementActiveRequestCount();
+
+            await waitTask;
+        }
+
+        [Fact]
+        public async Task WaitForActiveTranscodingRequests_ReturnsWithoutAnActiveRequest()
+        {
+            var job = new TranscodingJob(NullLogger<TranscodingJob>.Instance);
+
+            await DynamicHlsController.WaitForActiveTranscodingRequests(job, CancellationToken.None);
+            await DynamicHlsController.WaitForActiveTranscodingRequests(null, CancellationToken.None);
+        }
+
+        [Fact]
+        public async Task WaitForActiveTranscodingRequests_ObservesCancellation()
+        {
+            var job = new TranscodingJob(NullLogger<TranscodingJob>.Instance)
+            {
+                ActiveRequestCount = 1
+            };
+            using var cancellationTokenSource = new CancellationTokenSource();
+
+            var waitTask = DynamicHlsController.WaitForActiveTranscodingRequests(job, cancellationTokenSource.Token);
+            await cancellationTokenSource.CancelAsync();
+
+            await Assert.ThrowsAnyAsync<OperationCanceledException>(() => waitTask);
+        }
+
+        [Fact]
+        public async Task WaitForActiveTranscodingRequests_ExitsOnRequestAbortWithoutCancellingJobToken()
+        {
+            // Demonstrates the generic .NET CreateLinkedTokenSource composition GetDynamicSegment
+            // relies on (a job-lifetime token, standing in for the CTS handed to StartFfMpeg /
+            // job.CancellationTokenSource, linked with a separate token standing in for
+            // HttpContext.RequestAborted) using the pre-existing, unmodified
+            // WaitForActiveTranscodingRequests helper. This is NOT a regression guard for
+            // GetDynamicSegment's own CreateLinkedTokenSource wiring: it passes unchanged even with
+            // the controller reverted to bh-base, since it never calls into GetDynamicSegment and
+            // WaitForActiveTranscodingRequests itself already honored whatever token it was given.
+            // That wiring is verified by code reading only (see report).
+            var job = new TranscodingJob(NullLogger<TranscodingJob>.Instance)
+            {
+                ActiveRequestCount = 1
+            };
+            using var jobCancellationTokenSource = new CancellationTokenSource();
+            using var requestAbortedTokenSource = new CancellationTokenSource();
+            using var linkedCancellationTokenSource = CancellationTokenSource.CreateLinkedTokenSource(
+                jobCancellationTokenSource.Token,
+                requestAbortedTokenSource.Token);
+
+            var waitTask = DynamicHlsController.WaitForActiveTranscodingRequests(job, linkedCancellationTokenSource.Token);
+            var stopwatch = Stopwatch.StartNew();
+
+            await requestAbortedTokenSource.CancelAsync();
+
+            await Assert.ThrowsAnyAsync<OperationCanceledException>(() => waitTask);
+            Assert.True(stopwatch.Elapsed < TimeSpan.FromSeconds(1));
+
+            // The request aborting must not cancel the job-lifetime token: other code (the kill
+            // timer, KillTranscodingJobs) depends on that token representing the ffmpeg process's
+            // own lifetime rather than any one caller's connection.
+            Assert.False(jobCancellationTokenSource.IsCancellationRequested);
+        }
+
+        [Fact]
+        public async Task GetSegmentResult_RequestAborted_ExitsWaitLoopAndReleasesJobSlot()
+        {
+            // Regression test for GetSegmentResult's catch (OperationCanceledException) when
+            // (HttpContext.RequestAborted.IsCancellationRequested) branch (the ActiveRequestCount
+            // leak fix), which had zero coverage. Drives the actual (internal, not reimplemented)
+            // GetSegmentResult through a real DynamicHlsController whose HttpContext.RequestAborted
+            // is set to the token passed in, so the `when` filter observes an abort exactly as it
+            // would via GetDynamicSegment's linked token. The wait loop itself exits via whatever
+            // cancellationToken it is given regardless of this fix (that part is unconditional
+            // .NET CreateLinkedTokenSource/Task.Delay behavior, not new), so this test's actual
+            // regression coverage is the Verify below: reverting just the catch/decrement block
+            // (confirmed empirically against a scratch copy) leaves the wait loop exiting exactly
+            // the same way but OnTranscodeEndRequest never called, and Times.Once fails.
+            //
+            // This test does NOT cover GetDynamicSegment's own CreateLinkedTokenSource wiring (the
+            // LockAsync wait / WaitForActiveTranscodingRequests half of the finding) -- calling
+            // GetDynamicSegment itself requires StreamingHelpers.GetStreamingState's full
+            // mediaSource/user/library/encoding dependency graph, which was judged too costly to
+            // stand up for this scope. That half is verified by code reading only (see report).
+            var transcodeManager = new Mock<ITranscodeManager>();
+            using var requestAbortedSource = new CancellationTokenSource();
+            var controller = CreateController(transcodeManager, requestAbortedSource.Token);
+
+            // Not disposed: StreamState.Dispose reads the (unset, EncodingJobInfo-base) MediaSource
+            // property, which is unrelated to this test and would need a further unused stub.
+            var state = new StreamState(Mock.Of<IMediaSourceManager>(), TranscodingJobType.Hls, transcodeManager.Object)
+            {
+                Request = new StreamingRequestDto { SegmentContainer = "ts" }
+            };
+            var job = new TranscodingJob(NullLogger<TranscodingJob>.Instance) { HasExited = false };
+            var missingSegmentPath = Path.Combine(Path.GetTempPath(), Guid.NewGuid() + ".ts");
+
+            var resultTask = controller.GetSegmentResult(
+                state,
+                "playlist.m3u8",
+                missingSegmentPath,
+                "ts",
+                0,
+                job,
+                requestAbortedSource.Token);
+
+            var stopwatch = Stopwatch.StartNew();
+
+            await requestAbortedSource.CancelAsync();
+
+            await Assert.ThrowsAnyAsync<OperationCanceledException>(() => resultTask);
+            Assert.True(stopwatch.Elapsed < TimeSpan.FromSeconds(1));
+
+            // Without the fix's catch-and-decrement, an abort exits the wait loop without ever
+            // calling OnTranscodeEndRequest (that call normally only happens via the
+            // Response.OnCompleted callback registered by the non-throwing completion path below,
+            // which a thrown exception skips) -- leaking the slot this request holds and hanging a
+            // later request to the same playlist in WaitForActiveTranscodingRequests.
+            transcodeManager.Verify(t => t.OnTranscodeEndRequest(job), Times.Once);
+        }
+
+        [Fact]
+        public async Task ActiveRequestCount_UpdatesAtomically()
+        {
+            const int RequestCount = 1000;
+            var job = new TranscodingJob(NullLogger<TranscodingJob>.Instance);
+
+            await Task.WhenAll(
+                Task.Run(() => Parallel.For(0, RequestCount, _ => job.IncrementActiveRequestCount())),
+                Task.Run(() => Parallel.For(0, RequestCount, _ => job.DecrementActiveRequestCount())));
+
+            Assert.Equal(0, job.ActiveRequestCount);
+        }
+    }
+}
