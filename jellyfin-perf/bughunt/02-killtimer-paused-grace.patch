+    /// <summary>
+    /// Determines the kill-timer duration, in milliseconds, for a transcoding job. Extracted from
+    /// <see cref="PingTimer"/> so it is unit-testable without a live ffmpeg process.
+    /// </summary>
+    /// <param name="type">The transcoding job type.</param>
+    /// <param name="isUserPaused">Whether the client has most recently reported itself paused.</param>
+    /// <returns>The kill-timer duration, in milliseconds.</returns>
+    internal static int GetKillTimeoutMs(TranscodingJobType type, bool isUserPaused)
+    {
+        if (type == TranscodingJobType.Progressive)
+        {
+            return ProgressiveKillTimeoutMs;
+        }
+
+        return isUserPaused ? PausedKillTimeoutMs : DefaultKillTimeoutMs;
+    }
