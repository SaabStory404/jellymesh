+using MediaBrowser.Controller.MediaEncoding;
+using MediaBrowser.MediaEncoding.Transcoding;
+using Xunit;
+
+namespace Jellyfin.MediaEncoding.Tests.Transcoding
+{
+    /// <summary>
+    /// Tests for <see cref="TranscodeManager.GetKillTimeoutMs"/>, the kill-timer duration selection extracted
+    /// from <c>PingTimer</c> so a paused-but-connected HLS client is not killed and cold-restarted on the same
+    /// cadence as an abandoned one.
+    /// </summary>
+    public class TranscodeManagerPingTimerTests
+    {
+        [Theory]
+        [InlineData(TranscodingJobType.Hls)]
+        [InlineData(TranscodingJobType.Dash)]
+        public void GetKillTimeoutMs_PausedNonProgressive_IsLongerThanUnpaused(TranscodingJobType type)
+        {
+            var unpaused = TranscodeManager.GetKillTimeoutMs(type, false);
+            var paused = TranscodeManager.GetKillTimeoutMs(type, true);
+
+            Assert.True(paused > unpaused, "Paused kill timeout must be longer than the unpaused kill timeout.");
+        }
+
+        [Theory]
+        [InlineData(TranscodingJobType.Hls)]
+        [InlineData(TranscodingJobType.Dash)]
+        public void GetKillTimeoutMs_UnpausedNonProgressive_MatchesExistingSixtySecondTimeout(TranscodingJobType type)
+        {
+            Assert.Equal(60000, TranscodeManager.GetKillTimeoutMs(type, false));
+        }
+
+        [Theory]
+        [InlineData(TranscodingJobType.Hls)]
+        [InlineData(TranscodingJobType.Dash)]
+        public void GetKillTimeoutMs_PausedNonProgressive_IsBoundedGracePeriod(TranscodingJobType type)
+        {
+            var paused = TranscodeManager.GetKillTimeoutMs(type, true);
+
+            // Bounded: long enough to cover an ordinary pause, short enough that a client which reports
+            // paused and then vanishes cannot tie up a GPU transcode slot indefinitely (only 20 hardware
+            // encode slots are available in this deployment).
+            Assert.True(paused > 60000, "Paused grace period must exceed the unpaused HLS timeout.");
+            Assert.True(paused <= 300000, "Paused grace period must stay bounded (at most a few minutes).");
+        }
+
+        [Theory]
+        [InlineData(false)]
+        [InlineData(true)]
+        public void GetKillTimeoutMs_Progressive_IsUnaffectedByPauseState(bool isUserPaused)
+        {
+            // Progressive streams stop reliably on their own; pause state must never change their timing.
+            Assert.Equal(10000, TranscodeManager.GetKillTimeoutMs(TranscodingJobType.Progressive, isUserPaused));
+        }
+
+        [Theory]
+        [InlineData(TranscodingJobType.Hls, true)]
+        [InlineData(TranscodingJobType.Dash, true)]
+        public void GetKillTimeoutMs_PausedNonProgressive_ExceedsProgressiveTimeout(TranscodingJobType type, bool isUserPaused)
+        {
+            var paused = TranscodeManager.GetKillTimeoutMs(type, isUserPaused);
+            var progressive = TranscodeManager.GetKillTimeoutMs(TranscodingJobType.Progressive, isUserPaused);
+
+            Assert.True(paused > progressive);
+        }
+    }
+}
