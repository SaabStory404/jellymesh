# jellymesh-jellyfin 12.1-jm8.5: jm8.4 + Galera provider with NO PAD string collation.
#
#   galera/      Jellyfin.Database.Providers.Galera.dll built from galera/ (dotnet build -c Release):
#                every string column and the JSON_TABLE list binding use utf8mb4_0900_bin instead of
#                utf8mb4_bin. utf8mb4_bin is PAD SPACE ('a' = 'a '), so a tag that differed from an
#                existing one only by a trailing space failed the ItemValues (Type, Value) unique index
#                and the whole SaveChanges, leaving the item without metadata. Migration
#                20261122120000_NoPadStringCollation converts an existing database at startup (one
#                ALTER per table, 21 tables), under EF's migration lock.
#
#                Rollout: both replicas must move together. A jm8.4 node against converted columns
#                (or jm8.5 against unconverted ones) fails list filters with MySQL error 1267
#                "Illegal mix of collations" until it runs the matching image.
#
# Everything else is jm8.4's, unchanged.
#
# Build context = a staging dir holding galera/Jellyfin.Database.Providers.Galera.dll:
#   podman build -f image/Containerfile.jm8.5 -t ghcr.io/saabstory404/jellymesh-jellyfin:12.1-jm8.5 <ctx>
FROM ghcr.io/saabstory404/jellymesh-jellyfin:12.1-jm8.4@sha256:e6645621643a1143e80383ad3360ea28787906cea216f0bd6d17fc4ed6c524f8
COPY ["galera/Jellyfin.Database.Providers.Galera.dll", "/opt/jellymesh/plugins/JellyMesh Galera_1.0.0.0/"]
RUN cd /opt/jellymesh \
 && f="plugins/JellyMesh Galera_1.0.0.0/Jellyfin.Database.Providers.Galera.dll" \
 && grep -v " $f\$" SHA256SUMS > SHA256SUMS.new && sha256sum "$f" >> SHA256SUMS.new && mv SHA256SUMS.new SHA256SUMS
LABEL org.opencontainers.image.source="https://github.com/SaabStory404/jellymesh" \
      org.opencontainers.image.description="Jellyfin 12.1 + JellyMesh (shared-database HA, cross-node cache invalidation, shared transcode dir, NO PAD collation) + bughunt patches + transcode-pool shim (DV7->8.1, fMP4 HLS)"
