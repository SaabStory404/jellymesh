# jellymesh-jellyfin 12.1-jm8.4: jm8.1 + bughunt 17-19 (DV7->8.1 fMP4 HLS, incl. transcoded audio; gh-14).
#
#   overlay/     the 7 assemblies jellyfin-perf/build.sh (BUGHUNT=1, series 00-19) changes, copied over
#                /usr/lib/jellyfin/bin exactly as jm7/jm8/jm8.1 applied theirs
#                  17: JELLYMESH_DOVI_P7_TO_81=1: an HLS job that converts a DV profile-7 source to 8.1
#                      gets fMP4 segments even from a client whose only HLS profile is TS (dvvC in the init
#                      segment), video tagged hvc1. Flag off = unchanged.
#                  18: gh-14 -- mp4 HLS segments use -avoid_negative_ts make_non_negative (no negative audio
#                      tfdt), audioCodec accepts a 128-char list, truehd/mlp are dropped from the job's audio
#                      candidates (media3 cannot demux TrueHD from fMP4) and eac3 is moved first. Flag off =
#                      unchanged.
#                  19: 18's "prefer EAC3" never took effect: EncoderValidator's whitelist has no "eac3", so
#                      CanEncodeToAudioCodec("eac3") was false and EncodingHelper.AttachMediaSourceInfo picked
#                      the next candidate (AAC 5.1 for the Android TV list, MEASURED in tc-lab). eac3 is now
#                      detected, and a DV7->8.1 fMP4 job with a >=6ch TrueHD/MLP source encodes EAC3 5.1
#                      (640 kb/s) when the client lists eac3; AAC when it does not; AC3/EAC3 sources still
#                      copied. CanEncodeToAudioCodec("eac3") stays false, so every other job is unchanged.
#                      Flag off = unchanged.
#
# Everything else is jm8.1's, unchanged: the pool-r1 shim and sync, the Galera provider,
# install-plugins.sh and /opt/jellymesh/SHA256SUMS. Agents: any (pool-r1 3ed52b3 recommended); the
# agent's DV7->8.1 path already writes fMP4 with an hvc1+dvvC sample entry (dv81_it).
#
# Build context = a staging dir holding overlay/ (JF_OVERLAY=~/.cache/jellymesh-vendor/jellyfin-gh19):
#   podman build -f image/Containerfile.jm8.4 -t ghcr.io/saabstory404/jellymesh-jellyfin:12.1-jm8.4 <ctx>
FROM ghcr.io/saabstory404/jellymesh-jellyfin:12.1-jm8.1@sha256:30949335e3a568fc0efaa9ebc82ed3cf7a9b367808b3bd30bc51ba6ce4acec64
COPY overlay/ /usr/lib/jellyfin/bin/
LABEL org.opencontainers.image.source="https://github.com/SaabStory404/jellymesh" \
      org.opencontainers.image.description="Jellyfin 12.1 + JellyMesh (shared-database HA, cross-node cache invalidation, shared transcode dir) + bughunt patches + transcode-pool shim (DV7->8.1, fMP4 HLS)"
