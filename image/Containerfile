# JellyMesh Jellyfin: hotio Jellyfin 12.1 (digest-pinned, the build the patch is tested against)
# + jellymesh/jellyfin-perf patch (query shapes, write retry, JELLYFIN_SHARED_DB mode)
# + the Galera provider plugin and jellyfin-dbmigrate under /opt/jellymesh (installed into
#   /config by the cutover Job; Jellyfin only loads plugins from /config/data/plugins).
FROM ghcr.io/hotio/jellyfin:release-12.1@sha256:81de291f9d0813350ad6412e10f3333c4153276798e1f44c3b9e862791fecda3
COPY overlay/Emby.Server.Implementations.dll overlay/Jellyfin.Server.Implementations.dll overlay/MediaBrowser.Controller.dll /usr/lib/jellyfin/bin/
COPY plugin/ /opt/jellymesh/plugin/
COPY dbmigrate/jellyfin-dbmigrate dbmigrate/libe_sqlite3.so /opt/jellymesh/
COPY SHA256SUMS /opt/jellymesh/SHA256SUMS
LABEL org.opencontainers.image.source="https://github.com/SaabStory404/jellymesh" \
      org.opencontainers.image.description="Jellyfin 12.1 + JellyMesh patch + Galera provider"
