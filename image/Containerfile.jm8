# jellymesh-jellyfin 12.1-jm8: jm7.1 + bughunt patch 16 (shared transcode dir) + the detach-aware shim.
#
#   overlay/     the 7 assemblies jellyfin-perf/build.sh (BUGHUNT=1, series 00-16) changes, copied over
#                /usr/lib/jellyfin/bin exactly as jm7/jm7.1 applied theirs
#                  16: JELLYMESH_SHARED_TRANSCODE_DIR=1: both replicas share one transcode dir; session
#                      keepalive + viewer position (<keepalive>.seg) touched on any replica, kill timer
#                      reads the keepalive, lease-scoped cleanup, seek takeover, keepalive path handed
#                      to the pool shim (JELLYMESH_KEEPALIVE). Flag off = unchanged.
#   tcpool-shim  replaces the shim at /usr/lib/jellyfin-ffmpeg/ffmpeg (ffmpeg.real is already in place)
#   tcpool-sync  replaces /usr/local/bin/tcpool-sync
#
# The Galera provider, install-plugins.sh and /opt/jellymesh/SHA256SUMS are jm7.1's (not touched).
# The shim needs agents built from the same commit (or any agent: an old agent ignores the keepalive
# field, so the job is fenced on shim loss as before).
#
# Build context = a staging dir holding overlay/ plus the static musl binaries
# (transcode/deploy/build-musl.sh), all built from one committed SHA:
#   podman build -f image/Containerfile.jm8 -t ghcr.io/saabstory404/jellymesh-jellyfin:12.1-jm8 <ctx>
FROM ghcr.io/saabstory404/jellymesh-jellyfin:12.1-jm7.1@sha256:ec0d2bf6ec3c9771c93d558e4446499a0a1842dca256070c78f49ec74dc7e977
COPY overlay/ /usr/lib/jellyfin/bin/
COPY tcpool-shim /usr/lib/jellyfin-ffmpeg/ffmpeg
COPY tcpool-sync /usr/local/bin/tcpool-sync
LABEL org.opencontainers.image.source="https://github.com/SaabStory404/jellymesh" \
      org.opencontainers.image.description="Jellyfin 12.1 + JellyMesh (shared-database HA, cross-node cache invalidation, shared transcode dir) + bughunt patches + transcode-pool shim (DV7->8.1)"
