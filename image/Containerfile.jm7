# jellymesh-jellyfin 12.1-jm7: jm6 + bughunt patches 14/15 + the Galera provider password-redaction fix.
#
#   overlay/     the 7 assemblies jellyfin-perf/build.sh (BUGHUNT=1, series 00-15) changes, copied over
#                /usr/lib/jellyfin/bin exactly as jm6 applied its overlay
#                  14: UserDataChangeNotifier survives a DB write-node failover (was a process crash)
#                  15: JELLYFIN_SHARED_DB=1 cross-node item-cache invalidation through a
#                      JellyMeshItemInvalidation table in the same database (CREATE TABLE IF NOT EXISTS
#                      on first use; opt out with JELLYFIN_SHARED_INVALIDATION=0)
#   galera/      Jellyfin.Database.Providers.Galera.dll built from galera/ (redacts quoted passwords
#                containing ';'); jm6's Pomelo + MySqlConnector stay. install-plugins.sh (initContainer)
#                copies it into /config/data/plugins, so the initContainer image must be jm7 too.
#   install-plugins.sh  image/install-plugins.sh: skips identical DLLs and replaces changed ones by
#                rename (new inode), never in place. jm6's cp -f rewrote the shared DLL under the
#                other, still-running replica (lab: jm6 died with BadImageFormatException "Bad IL range").
#
# The shim and tcpool-sync are unchanged from jm6.
#
# Build context = a staging dir holding overlay/, galera/ and install-plugins.sh, built from one committed SHA:
#   podman build -f image/Containerfile.jm7 -t ghcr.io/saabstory404/jellymesh-jellyfin:12.1-jm7 <ctx>
FROM ghcr.io/saabstory404/jellymesh-jellyfin:12.1-jm6@sha256:9075a9540f3086b19fa756c91936401aa61b5c20cac8020bc3a0b16b59f3ae24
COPY overlay/ /usr/lib/jellyfin/bin/
COPY ["galera/Jellyfin.Database.Providers.Galera.dll", "/opt/jellymesh/plugins/JellyMesh Galera_1.0.0.0/"]
COPY --chmod=755 install-plugins.sh /opt/jellymesh/install-plugins.sh
# Refresh the two replaced files' lines in the (jm3-era, build-context-relative) SHA256SUMS.
RUN cd /opt/jellymesh \
 && for f in "plugins/JellyMesh Galera_1.0.0.0/Jellyfin.Database.Providers.Galera.dll" install-plugins.sh; do \
      grep -v " $f\$" SHA256SUMS > SHA256SUMS.new && sha256sum "$f" >> SHA256SUMS.new && mv SHA256SUMS.new SHA256SUMS; \
    done
LABEL org.opencontainers.image.source="https://github.com/SaabStory404/jellymesh" \
      org.opencontainers.image.description="Jellyfin 12.1 + JellyMesh (shared-database HA, cross-node cache invalidation) + bughunt patches + transcode-pool shim (DV7->8.1)"
