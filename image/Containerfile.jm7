# jellymesh-jellyfin 12.1-jm7: jm6 + bughunt patch 14 (shared transcode dir) + the detach-aware shim.
#
#   overlay/     the 7 assemblies jellyfin-perf/build.sh (BUGHUNT=1) changes, copied over
#                /usr/lib/jellyfin/bin exactly as jm3/jm4 applied the perf overlay
#   tcpool-shim  replaces jm5's shim at /usr/lib/jellyfin-ffmpeg/ffmpeg (ffmpeg.real is already
#                in place from jm5)
#   tcpool-sync  replaces jm5's /usr/local/bin/tcpool-sync
#
# New behaviour is off by default: JELLYMESH_DOVI_P7_TO_81 (patch 13, DV7 -> 8.1 decision) and
# JELLYMESH_SHARED_TRANSCODE_DIR (patches 03 + 14) are both opt-in env flags.
#
# Build context = a staging dir holding overlay/ plus the static musl binaries
# (transcode/deploy/build-musl.sh), all built from one committed SHA:
#   podman build -f image/Containerfile.jm7 -t ghcr.io/saabstory404/jellymesh-jellyfin:12.1-jm7 <ctx>
FROM ghcr.io/saabstory404/jellymesh-jellyfin:12.1-jm6@sha256:9075a9540f3086b19fa756c91936401aa61b5c20cac8020bc3a0b16b59f3ae24
COPY overlay/ /usr/lib/jellyfin/bin/
COPY tcpool-shim /usr/lib/jellyfin-ffmpeg/ffmpeg
COPY tcpool-sync /usr/local/bin/tcpool-sync
LABEL org.opencontainers.image.source="https://github.com/SaabStory404/jellymesh" \
      org.opencontainers.image.description="Jellyfin 12.1 + JellyMesh (shared-database HA) + bughunt patches + transcode-pool shim (DV7->8.1)"
